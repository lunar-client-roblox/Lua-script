    local cam = workspace.CurrentCamera
    if not cam then
        return
    end

    currentTarget = findTarget()
    local mode = Config.aim.mode
    if Config.aim.enabled and currentTarget then
        if mode == 2 or mode == 3 then
            installSilent()
            silentTarget = currentTarget
        else
            silentTarget = nil
        end
        if mode == 1 or mode == 3 then
