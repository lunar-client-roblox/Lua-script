local function toData(v)
    local t = typeof(v)
    if t == "Color3" then
        return { __t = "Color3", r = v.R, g = v.G, b = v.B }
    elseif t == "table" then
        local out = {}
        for k, val in pairs(v) do
            local c = toData(val)
            if c ~= nil then
                out[k] = c
            end
        end
        return out
    elseif t == "number" or t == "string" or t == "boolean" then
        return v
    end
    return nil
end

local function fromData(v)
    if type(v) ~= "table" then
        return v
    end
    if v.__t == "Color3" then
        return Color3.new(tonumber(v.r) or 0, tonumber(v.g) or 0, tonumber(v.b) or 0)
    end
    local out = {}
    for k, val in pairs(v) do
        if k ~= "__t" then
            out[k] = fromData(val)
        end
    end
    return out
end

local function isArray(t)
    if type(t) ~= "table" then
        return false
    end
    local n = 0
    for k in pairs(t) do
        if type(k) ~= "number" then
            return false
        end
        n = n + 1
    end
    return n == #t
end

local function mergeSettings(dst, src)
    for k, v in pairs(src) do
        if k ~= "savedAt" then
            if type(v) == "table" and type(dst[k]) == "table" then
                if isArray(v) then
                    local arr = {}
                    for i, item in ipairs(v) do
                        arr[i] = item
                    end
                    dst[k] = arr
                else
                    mergeSettings(dst[k], v)
                end
            else
                dst[k] = v
            end
        end
    end
end

