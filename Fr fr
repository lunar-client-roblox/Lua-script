    Config.yt.tracks[#Config.yt.tracks + 1] = {
        id = normalizeAudioId(t.id),
        path = "",
        kind = "id",
        title = title,
        artist = tostring(t.artist or ""),
        lyrics = tostring(t.lyrics or ""),
