local function updateEsp()
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end
    local screen = cam.ViewportSize

    for player, ui in pairs(espCache) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local alive = char ~= nil
            and hum ~= nil
            and hum.Health > 0
            and root ~= nil
            and head ~= nil

        if not alive then
            ui.holder.Visible = false
        else
            local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
            local bottom = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.6, 0))
            local h = bottom.Y - top.Y

            if top.Z <= 0 or bottom.Z <= 0 or h < 8 then
                ui.holder.Visible = false
            else
                ui.holder.Visible = true

                local col = rainbowColor(Config.esp.color, 0.15, ui.offset)
                local w = h * 0.52
                local cx = (top.X + bottom.X) * 0.5
                local left = cx - w * 0.5
                local right = left + w
                local boxTop = top.Y
                local boxBottom = top.Y + h
                local style = Config.esp.style

                local showBox = Config.esp.box2d and (style == 1 or style == 3 or style == 4)
                ui.box.Visible = showBox
                if showBox then
                    ui.box.Position = UDim2.fromOffset(left, boxTop)
                    ui.box.Size = UDim2.fromOffset(w, h)
                    ui.boxStroke.Color = col
                    ui.boxStroke.Thickness = style == 4 and 2 or 1.5
                    ui.boxGrad.Enabled = style == 4
                    ui.boxGrad.Color = ColorSequence.new(
                        col,
                        rainbowColor(Config.esp.targetColor, 0.15, ui.offset + 0.5)
                    )
                end

                local showCorners = Config.esp.box2d and (style == 2 or style == 3)
                if showCorners then
                    local len = math.clamp(w * 0.24, 6, 18)
                    for _, c in ipairs(ui.corners) do
                        local f = c.frame
                        f.Visible = true
                        f.BackgroundColor3 = col
                        if c.horizontal then
                            f.Size = UDim2.fromOffset(len, 2)
                            f.Position = UDim2.fromOffset(
                                c.cx == 0 and left or right - len,
                                c.cy == 0 and boxTop or boxBottom - 2
                            )
                        else
                            f.Size = UDim2.fromOffset(2, len)
                            f.Position = UDim2.fromOffset(
                                c.cx == 0 and left or right - 2,
                                c.cy == 0 and boxTop or boxBottom - len
                            )
                        end
                    end
                else
                    for _, c in ipairs(ui.corners) do
                        c.frame.Visible = false
                    end
                end

                ui.headDot.Visible = Config.esp.box2d
                if Config.esp.box2d then
                    ui.headDot.Position = UDim2.fromOffset(cx - 2, top.Y - 5)
                    ui.headDot.BackgroundColor3 = col
                end

                ui.tracer.Visible = Config.esp.tracer
                if Config.esp.tracer then
                    local a = Vector2.new(screen.X * 0.5, screen.Y)
                    local b = Vector2.new(cx, boxBottom)
                    local dx, dy = b.X - a.X, b.Y - a.Y
                    local len = math.sqrt(dx * dx + dy * dy)
                    if len > 2 then
                        ui.tracer.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
                        ui.tracer.Size = UDim2.fromOffset(len, 1)
                        ui.tracer.Rotation = math.deg(math.atan2(dy, dx))
                        ui.tracer.BackgroundColor3 = col
                    else
                        ui.tracer.Visible = false
                    end
                end

                ui.name.Visible = Config.esp.name
                ui.name.Text = player.Name
                ui.name.Position = UDim2.fromOffset(cx, boxTop - 3)
                ui.name.TextColor3 = col

                local dist = (cam.CFrame.Position - root.Position).Magnitude
                ui.dist.Visible = Config.esp.distance
                ui.dist.Text = string.format("%d m", math.floor(dist + 0.5))
                ui.dist.Position = UDim2.fromOffset(cx, boxBottom + 3)
                ui.dist.TextColor3 = Theme.muted

                local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                ui.healthBg.Visible = Config.esp.health
                ui.healthBg.Position = UDim2.fromOffset(left - 6, boxTop)
                ui.healthBg.Size = UDim2.fromOffset(3, h)
                ui.healthFill.Size = UDim2.new(1, 0, hp, 0)
                ui.healthFill.Position = UDim2.new(0, 0, 1 - hp, 0)
                ui.healthFill.BackgroundColor3 =
                    Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(80, 220, 120), hp)

                if Config.esp.box3d then
                    local ok, bcf, bsize = pcall(char.GetBoundingBox, char)
                    if ok and bcf and bsize then
                        local pts = {}
                        local depth = {}
                        local valid = true
                        for i = 1, 8 do
                            local sx = (i % 2 == 0) and 0.5 or -0.5
                            local sy = (math.floor(i / 2) % 2 == 0) and 0.5 or -0.5
                            local sz = (math.floor(i / 4) % 2 == 0) and 0.5 or -0.5
                            local world = bcf * Vector3.new(
                                bsize.X * sx, bsize.Y * sy, bsize.Z * sz
                            )
                            local sp = cam:WorldToViewportPoint(world)
                            if sp.Z <= 0 then
                                valid = false
                                break
                            end
                            pts[i] = Vector2.new(sp.X, sp.Y)
                            depth[i] = sp.Z
                        end
                        if valid then
                            local dark = Color3.fromRGB(6, 8, 14)
                            for idx, edge in ipairs(EDGES) do
                                local line = ui.lines[idx]
                                local d = (depth[edge[1]] + depth[edge[2]]) * 0.5
                                local far = math.clamp((d - 14) / 150, 0, 1)
                                line.BackgroundColor3 = col:Lerp(dark, far * 0.6)
                                line.BackgroundTransparency = far * 0.45
                                if line.Stroke then
                                    line.Stroke.Color = col:Lerp(dark, far * 0.4)
                                    line.Stroke.Transparency = 0.3 + far * 0.5
                                end
                                setLine(
                                    line,
                                    pts[edge[1]],
                                    pts[edge[2]],
                                    2.6 - far * 1.3
                                )
                            end
                        else
                            hideLines(ui)
                        end
                    else
                        hideLines(ui)
                    end
                else
                    hideLines(ui)
                end
            end
        end
    end
end

