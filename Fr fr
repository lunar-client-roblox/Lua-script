    local WEAPON_KEYS = { trident = true, thorhammer = true, scythe = true }

    -- Roll quanh truc doc cua vu khi cho tung mon / tung kieu cam.
    -- 1 = Forward (ngang, chi ra truoc), 2 = Side (ngang, quay ra ngoai),
    -- 3 = Up (dung, giong cam giao).
    local WEAPON_ROLL = {
        trident = { 0, 0, 0 },
        thorhammer = { 90, 90, 0 },
        scythe = { 180, 180, 0 },
    }

    -- Tra ve CFrame goc cua vu khi. Goc toa do (0,0,0) cua model la diem cam.
    -- Dung huong cua nhan vat (root) thay vi huong ban tay de vu khi luon
    -- nam ngang on dinh, khong bi xoay lung tung theo animation tay.
    local function weaponBase(char, hand, grip, key)
        if not char or not hand then
            return nil
        end
        local root = char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
        if not root then
            return nil
        end
        local gripCF = hand.CFrame * (grip or CFrame.new())
        local mode = math.floor(math.clamp(Config.cosmetic.hold or 1, 1, 3))
        local pos = gripCF.Position
        local cf
        if mode == 3 then
            -- Up: +Y = len tren, +Z = huong mat
            pos = pos
                + root.CFrame.LookVector * 0.05
                + root.CFrame.RightVector * 0.08
            local left = -root.CFrame.RightVector
            cf = CFrame.fromMatrix(
                pos,
                left,
                Vector3.new(0, 1, 0),
                root.CFrame.LookVector
            )
            cf = cf * CFrame.Angles(math.rad(-10), 0, math.rad(6))
        elseif mode == 2 then
            -- Side: +Y = huong sang phai, +Z = len tren
            pos = pos
                + root.CFrame.LookVector * 0.32
                + root.CFrame.RightVector * 0.18
            cf = CFrame.fromMatrix(
                pos,
                -root.CFrame.LookVector,
                root.CFrame.RightVector,
                root.CFrame.UpVector
            )
        else
            -- Forward: +Y = huong mat, +Z = len tren
            pos = pos
                + root.CFrame.LookVector * 0.30
                + root.CFrame.RightVector * 0.12
            cf = CFrame.fromMatrix(
                pos,
                root.CFrame.RightVector,
                root.CFrame.LookVector,
                root.CFrame.UpVector
            )
        end
        local rolls = WEAPON_ROLL[key]
        local roll = rolls and rolls[mode] or 0
        if roll ~= 0 then
            cf = cf * CFrame.Angles(0, math.rad(roll), 0)
        end
        return cf
    end

