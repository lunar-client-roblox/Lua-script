local function updateWalk()
    local style = walkStyle()

    if not Config.walk.enabled then
        if walkTrail and walkTrail.Parent then
            walkTrail.Enabled = false
        end
        if walkGlow and walkGlow.Parent then
            walkGlow.Enabled = false
        end
        for _, emitter in ipairs(walkEmitters) do
            if emitter and emitter.Parent then
                emitter.Rate = 0
                emitter.Enabled = false
            end
        end
        if walkAura and walkAura.Parent then
            walkAura.Rate = 0
            walkAura.Enabled = false
        end
        if walkLight and walkLight.Parent then
            walkLight.Brightness = 0
        end
        return
    end

    local char = LocalPlayer.Character
    if char ~= walkChar or not walkTrail or not walkTrail.Parent then
        buildWalkTrail(char)
    end
    if not walkTrail or not walkTrail.Parent then
        return
    end

    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude
    local moving = hum.MoveDirection.Magnitude > 0.1 or speed > 2
    local boost = math.clamp(speed / 22, 0, 1)
    local power = 0.6 + (Config.walk.power or 1) * 0.4
    local width = style.width * power * (1 + boost * 0.9)

    walkTrail.Enabled = moving
    walkGlow.Enabled = moving
    walkTrail.Lifetime = style.lifetime * (1 + boost * 0.5)
    walkGlow.Lifetime = walkTrail.Lifetime * 1.6
    walkTrail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width),
        NumberSequenceKeypoint.new(1, 0.12),
    })
    walkGlow.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width * 2.2),
        NumberSequenceKeypoint.new(1, 0.3),
    })

    local ca, cb = style.colorA, style.colorB
    if style.custom then
        ca = Config.walk.color
        cb = Config.walk.color:Lerp(Color3.new(1, 1, 1), 0.3)
    end
    if Config.walk.rainbow or style.name == "Rainbow" then
        local h = (tick() * 0.55) % 1
        ca = Color3.fromHSV(h, 0.9, 1)
        cb = Color3.fromHSV((h + 0.33) % 1, 0.9, 1)
    end
    local seq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ca),
        ColorSequenceKeypoint.new(0.5, cb),
        ColorSequenceKeypoint.new(1, ca:Lerp(Color3.new(1, 1, 1), 0.35)),
    })
    walkTrail.Color = seq
    walkGlow.Color = ColorSequence.new(
        ca:Lerp(Color3.new(1, 1, 1), 0.25),
        cb:Lerp(Color3.new(1, 1, 1), 0.15)
    )
    walkTrail.Texture = style.trailTexture
    walkGlow.Texture = style.glowTexture

    local rate = math.min(style.rate * power * (1 + boost), 180)
    for _, emitter in ipairs(walkEmitters) do
        if emitter and emitter.Parent then
            emitter.Color = seq
            emitter.Texture = style.particleTexture
            emitter.Speed = NumberRange.new(
                style.speedMin * (1 + boost * 0.6),
                style.speedMax * (1 + boost * 0.6)
            )
            emitter.Acceleration = Vector3.new(0, style.accelY or 8, 0)
            emitter.Rate = moving and rate or 0
            emitter.Enabled = moving
        end
    end

    if walkAura and walkAura.Parent then
        walkAura.Color = seq
        walkAura.Rate = moving and math.min(12 * power * (1 + boost), 40) or 0
        walkAura.Enabled = moving
    end

    if walkLight and walkLight.Parent then
        walkLight.Color = ca
        walkLight.Brightness = moving and (1.2 + boost * 2.2) or 0
        walkLight.Range = 8 + boost * 4
    end
end

