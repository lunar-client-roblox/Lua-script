--// theme application
applyTheme = function()
    syncTheme()

    for _, entry in ipairs(themed) do
        local inst = entry.inst
        if inst and inst.Parent then
            pcall(function()
                inst[entry.prop] = Theme[entry.key]
            end)
        end
    end

    panel.BackgroundColor3 = Theme.bg
    panel.BackgroundTransparency = Config.gui.transparency

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            pcall(function()
                d.Font = FONTS[Config.gui.font].font
            end)
        end
    end

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UICorner") and d:GetAttribute("themedCorner") then
            d.CornerRadius = UDim.new(0, Config.gui.corner)
        end
        if d:IsA("UIStroke") and d:GetAttribute("themedStroke") then
            d.Color = Theme.stroke
            d.Thickness = Config.gui.borderWidth
        end
    end

    local grad = header:FindFirstChildOfClass("UIGradient")
    if grad then
        grad.Color = ColorSequence.new(Theme.accent, Theme.bg2)
    end
    local iconGrad = icon:FindFirstChildOfClass("UIGradient")
    if iconGrad then
        iconGrad.Color = ColorSequence.new(Theme.accent, Theme.accent:Lerp(Color3.new(1, 1, 1), 0.35))
    end

    local id = string.gsub(Config.gui.imageId or "", "%s", "")
    id = string.gsub(id, "rbxassetid://", "")
    id = string.gsub(id, "rbxassetid:", "")
    if id ~= "" then
        panelImage.Image = "rbxassetid://" .. id
        panelImage.ImageTransparency = Config.gui.imageTransparency
    else
        panelImage.Image = ""
        panelImage.ImageTransparency = 1
    end

    for _, entry in ipairs(colorSwatches) do
        if entry.swatch and entry.swatch.Parent then
            entry.swatch.BackgroundColor3 = entry.target[entry.field]
        end
    end

    selectTab(activeTab)
end

--// panel behaviour
local function setPanel(open)
    if open then
        panel.Visible = true
        panelScale.Scale = 0.88
        TweenService:Create(
            panelScale,
            TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Scale = 1 }
        ):Play()
    else
        panel.Visible = false
    end
end

local function clampToScreen(frame)
    local pos = frame.Position
    local size = frame.AbsoluteSize
    local s = viewport()
    frame.Position = UDim2.fromOffset(
        math.clamp(pos.X.Offset, 0, math.max(0, s.X - size.X)),
        math.clamp(pos.Y.Offset, 0, math.max(0, s.Y - size.Y))
    )
end

local function draggable(frame, handle, onTap)
    local dragging, startInput, startPos, moved = false, nil, nil, 0

    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = frame.Position
            moved = 0
        end
    end))

    track(UIS.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            moved = math.max(moved, delta.Magnitude)
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            clampToScreen(frame)
            if onTap and moved < 8 then
                onTap()
            end
        end
    end))
end

