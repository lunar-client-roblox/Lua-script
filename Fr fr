        local a1 = new("Attachment", {}, p1)
        local beam = new("Beam", {
            Attachment0 = a0,
            Attachment1 = a1,
            FaceCamera = true,
            Segments = 16,
            LightEmission = 1,
            LightInfluence = 0,
            Width0 = 80,
            Width1 = 120,
            Color = ColorSequence.new(Config.sky.colorA, Config.sky.colorB),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.2, 0.45),
                NumberSequenceKeypoint.new(0.75, 0.55),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }, p0)
        auroraRays[#auroraRays + 1] = {
            kind = kind,
            index = index,
            p0 = p0,
            p1 = p1,
            beam = beam,
            phase = math.random() * math.pi * 2,
            depth = (kind == "ray")
                and ((math.random() - 0.5) * 320)
                or ((math.random() - 0.5) * 120),
        }
    end

    for i = 1, style.rays.count do
        add("ray", i)
    end
    for i = 1, style.bands.count do
