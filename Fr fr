local connections = {}
local function track(conn)
    connections[#connections + 1] = conn
    return conn
end

local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(inst, radius, themed)
    local c = new("UICorner", {
        CornerRadius = UDim.new(0, radius or Config.gui.corner),
    }, inst)
    if themed then
        c:SetAttribute("themedCorner", true)
    end
    return c
end

local function stroke(inst, color, thickness, themed)
    local s = new("UIStroke", {
        Color = color or Theme.stroke,
        Thickness = thickness or Config.gui.borderWidth,
    }, inst)
    if themed then
        s:SetAttribute("themedStroke", true)
    end
    return s
end

