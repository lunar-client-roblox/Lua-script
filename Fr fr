    local function buildWizard(parent, color)
        local model = new("Model", { Name = "CosWizard" }, parent)
        local parts = {}
        local function add(size, off, trans, shape, extra)
            return addCosPart(model, parts, size, off, color, trans, shape, extra)
        end

        local black = Color3.fromRGB(16, 13, 24)
        local function bar(a, b, thick)
            local dir = b - a
            local len = dir.Magnitude
            if len < 0.001 then
                return
            end
            local center = (a + b) * 0.5
            local up = math.abs(dir.Unit.Z) > 0.9
                and Vector3.new(0, 1, 0)
                or Vector3.new(0, 0, 1)
            add(
                Vector3.new(thick, thick, len),
                CFrame.lookAt(center, center + dir, up),
                0.02,
                Enum.PartType.Block,
                { lerp = 0.35, kind = "star" }
            )
        end

        for i = 1, 8 do
            local a = (i - 1) * math.pi / 4
            local tip = (i % 2 == 0) and 1.62 or 1.26
            add(
                Vector3.new(0.62, 0.11, tip),
                CFrame.Angles(0, -a, 0)
                    * CFrame.new(0, 0.06, tip * 0.5)
                    * CFrame.Angles(math.rad(-9), 0, 0),
                0.02,
                Enum.PartType.Block,
                { fixed = black }
            )
        end
        add(
            Vector3.new(0.20, 1.95, 1.95),
            CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)),
            0.05,
            Enum.PartType.Cylinder,
            { fixed = black }
        )
        add(
            Vector3.new(0.12, 2.12, 2.12),
            CFrame.new(0, 0.19, 0) * CFrame.Angles(0, 0, math.rad(90)),
            0.55,
            Enum.PartType.Cylinder,
            { fixed = black }
        )

        local starY = 2.55
        local R = 1.38
        local function tri(rotY, flip)
            local rot = CFrame.Angles(0, rotY, 0)
            local verts = {}
            for k = 0, 2 do
                local ang = math.rad(90 + k * 120 + (flip and 180 or 0))
                verts[#verts + 1] = rot * Vector3.new(
                    math.cos(ang) * R,
                    starY + math.sin(ang) * R,
                    0
                )
            end
            for k = 1, 3 do
                bar(verts[k], verts[(k % 3) + 1], 0.12)
            end
        end
        tri(0, false)
        tri(0, true)
        tri(math.rad(90), false)
        tri(math.rad(90), true)

        add(
            Vector3.new(0.34, 0.34, 0.34),
            CFrame.new(0, starY, 0),
            0,
            Enum.PartType.Ball,
            { lerp = 0.75 }
        )

        for i = 1, 10 do
            local a = (i - 1) * math.pi * 2 / 10
            add(
                Vector3.new(0.14, 0.14, 0.14),
                CFrame.Angles(0, -a, 0),
                0.05,
                Enum.PartType.Ball,
                {
                    kind = "rune",
                    angle = a,
                    radius = 1.62,
                    y = 0.85 + (i % 3) * 0.30,
                    lerp = 0.65,
                }
            )
        end

        add(
            Vector3.new(0.10, 2.6, 2.6),
            CFrame.new(0, 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)),
            0.82,
            Enum.PartType.Cylinder,
            { kind = "aura", lerp = 0.45 }
        )

        enhanceModel(model, color)
        return { model = model, parts = parts }
    end

