        math.floor(col.B * 255 + 0.5)
    )
    hueHandle.Position = UDim2.new(colorState.h, -2, 0.5, -12)
    satHandle.Position = UDim2.new(colorState.s, -2, 0.5, -12)
    valHandle.Position = UDim2.new(colorState.v, -2, 0.5, -12)
    satGrad.Color = ColorSequence.new(
        Color3.fromHSV(colorState.h, 0, colorState.v),
        Color3.fromHSV(colorState.h, 1, colorState.v)
    )
    valGrad.Color = ColorSequence.new(
        Color3.new(0, 0, 0),
        Color3.fromHSV(colorState.h, colorState.s, 1)
    )
end

local function commitPicker()
    if not colorState.target then
        return
    end
    local col = Color3.fromHSV(colorState.h, colorState.s, colorState.v)
    colorState.target[colorState.field] = col
    if colorState.swatch then
        colorState.swatch.BackgroundColor3 = col
    end
    if colorState.onChange then
        colorState.onChange(col)
    end
    refreshPicker()
end

local function attachBar(bar, onAlpha)
    local dragging = false
    local function apply(input)
        local a = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
            0,
            1
        )
        onAlpha(a)
    end
    track(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            apply(input)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            apply(input)
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

attachBar(hueBar, function(a)
    colorState.h = a
    commitPicker()
end)
attachBar(satBar, function(a)
    colorState.s = a
    commitPicker()
end)
attachBar(valBar, function(a)
    colorState.v = a
    commitPicker()
end)

