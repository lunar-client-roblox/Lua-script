local function shockwave(pos, color, startRadius, endRadius, duration)
    local segments = 24
    local parts = {}
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        parts[i] = {
            angle = angle,
            part = new("Part", {
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Material = Enum.Material.Neon,
                Color = color,
                Size = Vector3.new(0.35, 0.12, 1.4),
                CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
                    * CFrame.new(0, 0, startRadius),
                Transparency = 0.1,
            }, fxFolder),
        }
    end

    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not parts[1].part.Parent then
            conn:Disconnect()
            return
        end
        local a = math.clamp((tick() - start) / duration, 0, 1)
        local radius = startRadius + (endRadius - startRadius) * a
        local fade = 0.1 + 0.9 * a
        for _, entry in ipairs(parts) do
            entry.part.CFrame = CFrame.new(pos)
                * CFrame.Angles(0, entry.angle, 0)
                * CFrame.new(0, 0, radius)
            entry.part.Transparency = fade
            entry.part.Size = Vector3.new(
                0.35 * (1 - a),
                0.12,
                1.4 * (1 - a * 0.5)
            )
        end
        if a >= 1 then
            conn:Disconnect()
            for _, entry in ipairs(parts) do
                entry.part:Destroy()
            end
        end
    end)
end

local function jumpRing(pos, col, duration, radius)
    local segments = 32
    local model = new("Model", { Name = "BenchJumpRing" }, fxFolder)
    local items = {}
    local arc = (2 * math.pi * radius) / segments * 1.18
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        items[i] = {
            angle = angle,
            part = new("Part", {
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Material = Enum.Material.Neon,
                Color = col,
                Size = Vector3.new(arc, 0.06, 0.16),
                CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0))
                    * CFrame.Angles(0, angle, 0)
                    * CFrame.new(0, 0, radius),
                Transparency = 0.12,
            }, model),
        }
    end
    new("PointLight", {
        Brightness = 2.2,
        Range = radius * 2.4,
        Color = col,
    }, new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        CastShadow = false,
        Transparency = 1,
        Size = Vector3.new(0.2, 0.2, 0.2),
        CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)),
    }, model))

    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not model.Parent then
            conn:Disconnect()
            return
        end
        local age = tick() - start
        local a = math.clamp(age / duration, 0, 1)
        local pulse = 0.5 + 0.5 * math.sin(age * 6.2)
        local fade
        if a < 0.55 then
            fade = 0.08 + 0.14 * pulse
        else
            fade = 0.22 + ((a - 0.55) / 0.45) * 0.78
        end
        local grow = 1 + 0.16 * math.min(a / 0.22, 1)
        local base = CFrame.new(pos + Vector3.new(0, 0.08, 0))
            * CFrame.Angles(0, age * 0.4, 0)
        for _, item in ipairs(items) do
            item.part.CFrame = base
                * CFrame.Angles(0, item.angle, 0)
                * CFrame.new(0, 0, radius * grow)
            item.part.Transparency = math.clamp(fade, 0, 1)
            item.part.Size = Vector3.new(arc * grow, 0.06, 0.16)
        end
        if a >= 1 then
            conn:Disconnect()
            model:Destroy()
        end
    end)
end

