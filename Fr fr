--// teardown
unload = function()
    for _, conn in ipairs(connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    connections = {}

    if humConn then
        pcall(function()
            humConn:Disconnect()
        end)
        humConn = nil
    end

    silentTarget = nil
    if silentReady and silentOld and restorefunction then
        pcall(function()
            restorefunction(silentOld)
        end)
        silentReady = false
    end

    pcall(disableSky)
    pcall(clearOrbit)
    pcall(clearWalkTrail)
    pcall(function()
        if fxFolder then
            fxFolder:Destroy()
        end
    end)
    pcall(function()
        gui:Destroy()
    end)
    pcall(function()
        espGui:Destroy()
    end)
    pcall(function()
        targetHighlight:Destroy()
    end)

    if getgenv then
        getgenv().BenchUnload = nil
    end
end

if getgenv then
    getgenv().BenchUnload = unload
end



