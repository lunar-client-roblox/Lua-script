local function updateTargetFx()
    local target = currentTarget
    local col = Config.esp.targetColor
    if target and target.Parent then
        if Config.esp.targetHighlight then
            targetHighlight.Adornee = target.Parent
            targetHighlight.Enabled = true
            targetHighlight.FillColor = col
            targetHighlight.FillTransparency = 0.55 + 0.2 * math.sin(tick() * 6)
            targetHighlight.OutlineColor = col:Lerp(Color3.new(1, 1, 1), 0.6)
        else
            targetHighlight.Enabled = false
        end

        local head = target.Parent:FindFirstChild("Head") or target
        local cam = workspace.CurrentCamera
        local sp = cam and cam:WorldToViewportPoint(head.Position) or Vector3.zero

        if Config.esp.reticle and sp.Z > 0 then
            reticle.Visible = true
            reticle.Position = UDim2.fromOffset(sp.X, sp.Y)
            local spin = Config.esp.targetSpin or 0
            reticle.Rotation = (tick() * spin) % 360
            for i, dot in ipairs(reticleDots) do
                local ang = tick() * spin * 1.7 + (i - 1) * (math.pi * 2 / 3)
                dot.Position = UDim2.fromOffset(
                    26 + math.cos(ang) * 21,
                    26 + math.sin(ang) * 21
                )
            end
            reticleScale.Scale = 0.92 + 0.1 * math.sin(tick() * 7)
            for _, child in ipairs(reticle:GetChildren()) do
                if child:IsA("Frame") then
                    child.BackgroundColor3 = col
                end
            end
        else
            reticle.Visible = false
        end

        local root = target.Parent:FindFirstChild("HumanoidRootPart")
        if root and sp.Z > 0 then
            local feet = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
            if feet.Z > 0 then
                pulseRing.Visible = true
                local pulse = 1 + 0.25 * math.sin(tick() * 5)
                local size = 46 * pulse
                pulseRing.Position = UDim2.fromOffset(feet.X, feet.Y)
                pulseRing.Size = UDim2.fromOffset(size, size * 0.4)
                ringStroke.Color = col
                ringStroke.Transparency = 0.2 + 0.3 * math.sin(tick() * 5)
            else
                pulseRing.Visible = false
            end
        else
            pulseRing.Visible = false
        end

        if Config.esp.reticle and sp.Z > 0 then
            targetTag.Visible = true
            targetTag.Position = UDim2.fromOffset(sp.X, sp.Y - 32)
            targetTag.TextColor3 = col
        else
            targetTag.Visible = false
        end
    else
        targetHighlight.Enabled = false
        reticle.Visible = false
        pulseRing.Visible = false
        targetTag.Visible = false
    end
end

--// aim
local mouse = LocalPlayer:GetMouse()
local silentTarget = nil
local silentReady = false
local silentOld = nil

local function installSilent()
    if silentReady then
        return true
    end
    if not (hookmetamethod and getrawmetatable) then
        return false
    end
    pcall(function()
        local old
        old = hookmetamethod(game, "__index", function(self, key)
            if self == mouse and silentTarget and silentTarget.Parent then
                if key == "Hit" then
                    return CFrame.new(silentTarget.Position)
                elseif key == "Target" then
                    return silentTarget
                elseif key == "UnitRay" then
                    local cam = workspace.CurrentCamera
                    local origin = cam.CFrame.Position
                    return Ray.new(origin, (silentTarget.Position - origin).Unit)
                elseif key == "Origin" then
                    return workspace.CurrentCamera.CFrame.Position
                end
            end
            return old(self, key)
        end)
        silentOld = old
        silentReady = true
    end)
    return silentReady
end

local function isBlocked(part, char)
    local cam = workspace.CurrentCamera
    if not cam then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    if LocalPlayer.Character then
        filter[#filter + 1] = LocalPlayer.Character
    end
    if char then
        filter[#filter + 1] = char
    end
    params.FilterDescendantsInstances = filter
    local origin = cam.CFrame.Position
    return workspace:Raycast(origin, part.Position - origin, params) ~= nil
end

local function partOf(char)
    if not char then
        return nil
    end
    local name = AIM_PARTS[Config.aim.part] or "Head"
    local part = char:FindFirstChild(name)
    if part and part:IsA("BasePart") then
        return part
    end
    part = char:FindFirstChild("Head")
    if part and part:IsA("BasePart") then
        return part
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function findTarget()
    local cam = workspace.CurrentCamera
    if not cam then
        return nil
    end
    local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local best, bestDist = nil, Config.aim.fov * 0.5

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then
                local teamOk = true
                if Config.aim.teamCheck and plr.Team and LocalPlayer.Team then
                    teamOk = plr.Team ~= LocalPlayer.Team
                end
                if teamOk then
                    local part = partOf(char)
                    if part then
                        local sp = cam:WorldToViewportPoint(part.Position)
                        if sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < bestDist
                                and (not Config.aim.wallCheck
                                or not isBlocked(part, char)) then
                                best, bestDist = part, d
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function applyAim(part, factor)
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end
    local pos = part.Position
    if Config.aim.predict > 0 then
        pos = pos + part.AssemblyLinearVelocity * (Config.aim.predict / 100)
    end
    local goal = CFrame.lookAt(cam.CFrame.Position, pos)
    local alpha = math.clamp(1 / math.max(Config.aim.smooth, 1), 0.03, 1) * (factor or 1)
    cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end

