        local selDef = ui.cosDefs and ui.cosDefs[Config.cosmetic.selected]
        local itemOnly = ui.cosItemOnly and selDef ~= nil

        setPreviewBodyVisible(not itemOnly)
        local handShown = itemOnly and selDef and selDef.cat == "hand"
        if handShown ~= previewHandShown then
            previewHandShown = handShown
            if previewHand then
                previewHand.Parent = handShown and previewWorld or nil
            end
        end

        for i, key in ipairs(COS_KEYS) do
            local cm = previewModels[key]
            local cfg = Config.cosmetic[key]
            if cm then
                local base
                if itemOnly then
                    if selDef and key == selDef.key then
                        base = itemBase(key, selDef, cm)
                        local center, maxDim = modelBounds(cm)
                        previewItemTarget = base * center
                        previewItemRadius = maxDim * 1.35 + 1.2
                    end
                elseif key == "wings" or key == "dragonwings" then
                    if torso then
                        base = torso.CFrame
                            * CFrame.new(0, 0.35, torso.Size.Z * 0.5 + 0.12)
                    end
                elseif key == "dragon" then
                    local root = torso or head
                    if root then
                        local a = t * 1.35
                        local pos = Vector3.new(
                            math.cos(a) * 2.35,
                            0.85 + math.sin(t * 2.3) * 0.32,
                            math.sin(a) * 2.35
                        )
                        local vel = Vector3.new(-math.sin(a), 0, math.cos(a))
                        base = root.CFrame
                            * CFrame.lookAt(pos, pos + vel)
                    end
                elseif WEAPON_KEYS[key] then
                    local hand, grip = findRightHand(previewChar)
                    if hand then
                        base = weaponBase(previewChar, hand, grip, key)
                    end
                elseif head then
                    base = head.CFrame
                        * CFrame.new(0, head.Size.Y * 0.5 + 0.05, 0)
                end

                local ghost = not cfg.enabled
                local visible = cfg.enabled or (Config.cosmetic.selected == i)
                if ui.cosPreviewOnly then
                    visible = Config.cosmetic.selected == i
                    ghost = false
                end
                if itemOnly then
                    visible = selDef and key == selDef.key
                    ghost = false
                end
                if base and visible then
                    if key ~= "wings" and key ~= "dragonwings"
                        and key ~= "dragon" and not WEAPON_KEYS[key] then
                        previewAngles[key] =
                            (previewAngles[key] or 0) + dt * math.rad(cfg.spin or 0)
                    end
                    updateModel(
                        cm,
                        base,
                        cfg,
                        t,
                        previewAngles[key] or 0,
                        true,
                        ghost
                    )
                else
                    setModelVisible(cm, false, false)
                end
            end
        end

        if ui.cosPreviewCam then
            if not previewDrag then
                previewSpin = previewSpin + dt * 0.45
            end
            local spin = previewSpin + previewYaw
            local target = Vector3.new(0, 0.25, 0)
            local radius = 9.6
            local camY = 1.5
            if itemOnly then
                target = previewItemTarget
                radius = previewItemRadius
                camY = target.Y + radius * 0.35
            end
            ui.cosPreviewCam.CFrame = CFrame.lookAt(
                Vector3.new(
                    target.X + math.cos(spin) * radius,
                    camY + previewPitch,
                    target.Z + math.sin(spin) * radius
                ),
                target
            )
        end
    end

    local function updateCosmeticsImpl(dt)
        if not benchAlive then
            return
        end
        dt = dt or 0.016
        local t = tick()
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        local torso = char
            and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))

        for _, key in ipairs(COS_KEYS) do
            local cm = worldModels[key]
            local cfg = Config.cosmetic[key]
            if cm then
                local base
                if key == "wings" or key == "dragonwings" then
                    if torso then
                        base = torso.CFrame
                            * CFrame.new(0, 0.35, torso.Size.Z * 0.5 + 0.12)
                    end
                elseif key == "dragon" then
                    local root = torso or head
                    if root then
                        local a = t * 1.35
                        local pos = Vector3.new(
                            math.cos(a) * 2.55,
                            0.85 + math.sin(t * 2.3) * 0.35,
                            math.sin(a) * 2.55
                        )
                        local vel = Vector3.new(-math.sin(a), 0, math.cos(a))
                        base = root.CFrame
                            * CFrame.lookAt(pos, pos + vel)
                    end
                elseif WEAPON_KEYS[key] then
                    local hand, grip = findRightHand(char)
                    if hand then
                        base = weaponBase(char, hand, grip, key)
                    end
                elseif head then
                    base = head.CFrame
                        * CFrame.new(0, head.Size.Y * 0.5 + 0.05, 0)
                end

                if base and cfg.enabled then
                    if key ~= "wings" and key ~= "dragonwings"
                        and key ~= "dragon" and not WEAPON_KEYS[key] then
                        cm.angle = (cm.angle or 0) + dt * math.rad(cfg.spin or 0)
                    end
                    updateModel(cm, base, cfg, t, cm.angle or 0, true, false)
                else
                    setModelVisible(cm, false, false)
                end
            end
        end

        updatePreviewImpl(dt, t)
        if ui.tickThumbs then
            ui.tickThumbs(t)
        end

        saveAcc = saveAcc + dt
        if saveAcc >= 5 then
            saveAcc = 0
            saveSettings()
        end
    end
    updateCosmetics = updateCosmeticsImpl

    setupPreview()
    track(LocalPlayer.CharacterAdded:Connect(function()
        task.delay(0.8, setupPreview)
    end))

    cosmeticRefresh()
    if ui.refreshCosThumbs then
        pcall(ui.refreshCosThumbs)
    end

    hubSound = new("Sound", {
        Name = "BenchMusicSound",
        Volume = math.clamp(Config.yt.volume / 100, 0, 1),
        Looped = false,
    }, SoundService)
    track(hubSound.Ended:Connect(function()
        if benchAlive and ui.ytNext then
            task.defer(ui.ytNext)
        end
    end))
    local firstSong = Config.yt.tracks[Config.yt.index]
    if firstSong and ui.trackAsset then
        local id = ui.trackAsset(firstSong)
        if id ~= "" then
            hubSound.SoundId = id
        end
    end
    ytUpdateHub()
end
