--// theme application
applyTheme = function()
    syncTheme()

    for _, entry in ipairs(themed) do
        local inst = entry.inst
        if inst and inst.Parent then
            pcall(function()
                inst[entry.prop] = Theme[entry.key]
            end)
        end
    end

    panel.BackgroundColor3 = Theme.bg
    panel.BackgroundTransparency = Config.gui.transparency

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            pcall(function()
                d.Font = FONTS[Config.gui.font].font
            end)
        end
    end

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UICorner") and d:GetAttribute("themedCorner") then
            d.CornerRadius = UDim.new(0, Config.gui.corner)
        end
        if d:IsA("UIStroke") and d:GetAttribute("themedStroke") then
            d.Color = Theme.stroke
            d.Thickness = Config.gui.borderWidth
        end
    end

    local grad = header:FindFirstChildOfClass("UIGradient")
    if grad then
        grad.Color = ColorSequence.new(Theme.accent, Theme.bg2)
    end
    local iconGrad = icon:FindFirstChildOfClass("UIGradient")
    if iconGrad then
        iconGrad.Color = ColorSequence.new(Theme.accent, Theme.accent:Lerp(Color3.new(1, 1, 1), 0.35))
    end

    local id = string.gsub(Config.gui.imageId or "", "%s", "")
    id = string.gsub(id, "rbxassetid://", "")
    id = string.gsub(id, "rbxassetid:", "")
    if id ~= "" then
        panelImage.Image = "rbxassetid://" .. id
        panelImage.ImageTransparency = Config.gui.imageTransparency
    else
        panelImage.Image = ""
        panelImage.ImageTransparency = 1
    end

    for _, entry in ipairs(colorSwatches) do
        if entry.swatch and entry.swatch.Parent then
            entry.swatch.BackgroundColor3 = entry.target[entry.field]
        end
    end

    selectTab(activeTab)
end

