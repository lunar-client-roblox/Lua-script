--// layout helpers
local orderCounters = setmetatable({}, { __mode = "k" })

local function addOrder(parent, child)
    local n = (orderCounters[parent] or 0) + 1
    orderCounters[parent] = n
    child.LayoutOrder = n
    return child
end

local function section(parent, text)
