local humConn = nil

local function shockwave(pos, color, startRadius, endRadius, duration)
    local segments = 24
    local parts = {}
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        parts[i] = {
            angle = angle,
            part = new("Part", {
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Material = Enum.Material.Neon,
                Color = color,
                Size = Vector3.new(0.35, 0.12, 1.4),
                CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
                    * CFrame.new(0, 0, startRadius),
                Transparency = 0.1,
            }, fxFolder),
        }
    end

    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not parts[1].part.Parent then
            conn:Disconnect()
            return
        end
        local a = math.clamp((tick() - start) / duration, 0, 1)
        local radius = startRadius + (endRadius - startRadius) * a
        local fade = 0.1 + 0.9 * a
        for _, entry in ipairs(parts) do
            entry.part.CFrame = CFrame.new(pos)
                * CFrame.Angles(0, entry.angle, 0)
                * CFrame.new(0, 0, radius)
            entry.part.Transparency = fade
            entry.part.Size = Vector3.new(
                0.35 * (1 - a),
                0.12,
                1.4 * (1 - a * 0.5)
            )
        end
        if a >= 1 then
            conn:Disconnect()
            for _, entry in ipairs(parts) do
                entry.part:Destroy()
            end
        end
    end)
end

local function jumpFx()
    if not Config.jump.enabled then
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local col = Config.jump.rainbow
        and Color3.fromHSV((tick() * 0.6) % 1, 0.85, 1)
        or Config.jump.color
    local pos = root.Position - Vector3.new(0, 2.7, 0)

    shockwave(pos, col, 1.4, 14, 0.55)
    task.delay(0.07, function()
        if not fxFolder.Parent then
            return
        end
        shockwave(pos, col:Lerp(Color3.new(1, 1, 1), 0.5), 0.8, 9, 0.45)
    end)

    local column = new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        CastShadow = false,
        Material = Enum.Material.Neon,
        Color = col,
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(8, 2.6, 2.6),
        CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
            * CFrame.Angles(0, 0, math.rad(90)),
        Transparency = 0.45,
    }, fxFolder)
    TweenService:Create(
        column,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(18, 0.4, 0.4), Transparency = 1 }
    ):Play()
    task.delay(0.5, function()
        column:Destroy()
    end)

    local burst = new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        CastShadow = false,
        Transparency = 1,
        Size = Vector3.new(1, 1, 1),
        CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)),
    }, fxFolder)
    local emitter = new("ParticleEmitter", {
        Color = ColorSequence.new(col),
        Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.9),
            NumberSequenceKeypoint.new(1, 0.1),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Lifetime = NumberRange.new(0.45, 0.8),
        Speed = NumberRange.new(14, 24),
        SpreadAngle = Vector2.new(180, 180),
        Rate = 0,
        LightEmission = 1,
        Texture = "rbxasset://textures/particles/sparkles_main.dds",
    }, burst)
    emitter:Emit(40)
    task.delay(1.1, function()
        burst:Destroy()
    end)
end

local function hookCharacter(char)
    if humConn then
        humConn:Disconnect()
        humConn = nil
    end
    local hum = char and char:WaitForChild("Humanoid", 5)
    if hum then
        humConn = hum.Jumping:Connect(jumpFx)
    end
end

