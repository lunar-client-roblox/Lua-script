local function updateOrbit(dt)
    dt = dt or 0.016
    local now = tick()
    local radius = Config.orbit.radius or 3.5
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local persistent = Config.orbit.persistent and Config.orbit.enabled
    if ui.orbitPersistentPrev and not persistent then
        clearOrbit()
    end
    ui.orbitPersistentPrev = persistent

    for i = #orbitEntities, 1, -1 do
        local entity = orbitEntities[i]
        local age = now - entity.t0
        local a = entity.life and (age / entity.life) or 0
        if not entity.model or not entity.model.Parent
            or (not persistent and a >= 1) then
            if entity.model then
                entity.model:Destroy()
            end
            table.remove(orbitEntities, i)
        else
            local modelCF
            local fade = math.clamp(a * a, 0, 1)
            if persistent and root then
                if not entity.orbitRadius then
                    local rel = entity.base - root.Position
                    entity.orbitRadius = math.clamp(
                        rel.Magnitude,
                        0.5,
                        radius * 1.6
                    )
                    entity.orbitAngle = math.atan2(rel.Z, rel.X)
                    entity.orbitY = math.clamp(rel.Y, -3, 3)
                    entity.orbitSpeed = 0.12 + math.random() * 0.22
                end
                local angle = entity.orbitAngle + now * entity.orbitSpeed
                local r = entity.orbitRadius
                local y = entity.orbitY + math.sin(now * 1.1 + entity.phase) * 0.35
                local pos = root.Position + Vector3.new(
                    math.cos(angle) * r,
                    y,
                    math.sin(angle) * r
                )
                local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                modelCF = CFrame.lookAt(pos, pos + tangent)
                if entity.kind == 1 then
                    modelCF = modelCF * CFrame.Angles(now * 2, now * 2.6, now * 1.4)
                end
            elseif persistent then
                modelCF = CFrame.new(entity.base)
            elseif entity.kind == 2 then
                local pos = entity.base + Vector3.new(
                    math.sin(age * 0.6 + entity.phase) * 0.35,
                    age * 1.1 + math.sin(age * 1.8 + entity.phase) * 0.25,
                    math.cos(age * 0.5 + entity.phase) * 0.35
                )
                modelCF = CFrame.new(pos)
                    * CFrame.Angles(
                        0,
                        age * 0.7 + entity.phase,
                        math.sin(age * 1.3 + entity.phase) * 0.08
                    )
            elseif entity.kind == 3 then
                local pos = entity.base + Vector3.new(
                    math.sin(age * 1.7 + entity.phase) * 1.3,
                    math.sin(age * 2.3 + entity.phase * 1.7) * 0.55 + age * 0.35,
                    math.cos(age * 1.3 + entity.phase) * 1.3
                )
                local nextPos = entity.base + Vector3.new(
                    math.sin((age + 0.08) * 1.7 + entity.phase) * 1.3,
                    math.sin((age + 0.08) * 2.3 + entity.phase * 1.7) * 0.55
                        + (age + 0.08) * 0.35,
                    math.cos((age + 0.08) * 1.3 + entity.phase) * 1.3
                )
                local dir = nextPos - pos
                if dir.Magnitude < 0.001 then
                    dir = Vector3.new(0, 0, 1)
                end
                modelCF = CFrame.lookAt(pos, pos + dir.Unit)
            else
                local pos = entity.base + Vector3.new(
                    math.sin(age * 0.9 + entity.phase) * 0.4,
                    age * 1.6,
                    math.cos(age * 0.8 + entity.phase) * 0.4
                )
                modelCF = CFrame.new(pos)
                    * CFrame.Angles(age * 2.2, age * 3.1, age * 1.7)
            end

            entity.model:PivotTo(modelCF)
            if entity.wingL then
                local flap = math.sin(age * 34 + entity.phase) * 0.55
                entity.wingL.CFrame = modelCF * entity.wingLOffset
                    * CFrame.Angles(0, 0, flap)
                entity.wingR.CFrame = modelCF * entity.wingROffset
                    * CFrame.Angles(0, 0, -flap)
            end

            if persistent then
                for _, entry in ipairs(entity.parts) do
                    entry.part.Transparency = entry.base
                end
                for _, entry in ipairs(entity.lights) do
                    entry.light.Brightness = entry.base
                end
                if entity.trail then
                    entity.trail.Enabled = true
                end
                if entity.emitter then
                    entity.emitter.Enabled = true
                end
            else
                for _, entry in ipairs(entity.parts) do
                    entry.part.Transparency = math.clamp(
                        entry.base + (1 - entry.base) * fade,
                        0,
                        1
                    )
                end
                for _, entry in ipairs(entity.lights) do
                    entry.light.Brightness = entry.base * (1 - fade)
                end
                if entity.trail and a > 0.6 then
                    entity.trail.Enabled = false
                end
                if entity.emitter and a > 0.65 then
                    entity.emitter.Enabled = false
                end
            end
        end
    end

    if not Config.orbit.enabled then
        return
    end

    local kind = Config.orbit.kind
    local count = math.max(Config.orbit.count or 8, 1)
    local baseCap = (kind == 2) and 12 or ((kind == 3) and 16 or 20)
    local cap = math.floor(baseCap * (1 + radius / 20) * (0.55 + count / 12))
    cap = math.clamp(cap, baseCap, 90)
    if #orbitEntities > cap then
        for i = #orbitEntities, cap + 1, -1 do
            local entity = orbitEntities[i]
            if entity and entity.model then
                entity.model:Destroy()
            end
            table.remove(orbitEntities, i)
        end
    end
    if #orbitEntities >= cap then
        return
    end

    orbitAcc = orbitAcc + dt
    local baseInterval = (kind == 2) and 2.4 or ((kind == 3) and 1.5 or 1)
    local interval = baseInterval / math.max(count * (1 + radius / 28), 1)
    interval = math.max(interval, 0.05)
    if orbitAcc < interval then
        return
    end
    orbitAcc = 0

    if not root then
        return
    end

    local scale = 0.7 + (Config.orbit.size or 1) * 0.3
    local angle = math.random() * math.pi * 2
    local dist = radius * (0.45 + math.random() * 0.75)
    local orbitY
    if kind == 2 then
        orbitY = -2.4 + math.random() * 0.8
    elseif kind == 3 then
        orbitY = -0.5 + math.random() * 2.5
    else
        orbitY = -1 + math.random() * 3
    end
    local base = root.Position + Vector3.new(
        math.cos(angle) * dist,
        orbitY,
        math.sin(angle) * dist
    )

    local col = orbitColor()
    if kind == 2 then
        spawnLantern(base, col, scale)
    elseif kind == 3 then
        spawnFirefly(base, col, scale)
    else
        spawnSparkle(base, col, scale)
    end
    local entity = orbitEntities[#orbitEntities]
    if entity then
        entity.orbitRadius = dist
        entity.orbitY = orbitY
        entity.orbitAngle = angle
        entity.orbitSpeed = (0.10 + math.random() * 0.22)
            * (kind == 3 and 1.8 or 1)
    end
end

