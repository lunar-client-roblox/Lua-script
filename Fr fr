local function loadSettings()
    local rawList = {}
    local rf = execEnv.readfile
    if type(rf) ~= "function" and type(readfile) == "function" then
        rf = readfile
    end
    local isf = execEnv.isfile
    if type(isf) ~= "function" and type(isfile) == "function" then
        isf = isfile
    end
    if type(rf) == "function" then
        local exists = true
        if type(isf) == "function" then
            local ok, res = pcall(isf, SETTINGS_PATH)
            exists = ok and res
        end
        if exists then
            local ok, raw = pcall(rf, SETTINGS_PATH)
            if ok and type(raw) == "string" then
                rawList[#rawList + 1] = raw
            end
        end
    end
    if getgenv then
        local ok, raw = pcall(function()
            return getgenv().BenchUISettings
        end)
        if ok and type(raw) == "string" then
            rawList[#rawList + 1] = raw
        end
    end

    local best, bestTime = nil, -1
    for _, raw in ipairs(rawList) do
        local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(data) == "table" then
            local stamp = tonumber(data.savedAt) or 0
            if stamp >= bestTime then
                best, bestTime = data, stamp
            end
        end
    end
    if best then
        pcall(applySettingsData, best)
    end
end

