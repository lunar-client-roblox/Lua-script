    local function buildDummyPreview(world)
        local model = new("Model", { Name = "PreviewDummy" }, world)
        local skin = Color3.fromRGB(232, 200, 170)
        local cloth = Color3.fromRGB(58, 66, 92)
        local function part(name, size, cf, color)
            return new("Part", {
                Name = name,
                Size = size,
                CFrame = cf,
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Material = Enum.Material.SmoothPlastic,
                Color = color,
            }, model)
        end
        part("Torso", Vector3.new(2, 2, 1), CFrame.new(0, 0, 0), cloth)
        part("Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 1.6, 0), skin)
        part("Left Arm", Vector3.new(0.8, 2, 0.8), CFrame.new(-1.45, 0, 0), skin)
        part("Right Arm", Vector3.new(0.8, 2, 0.8), CFrame.new(1.45, 0, 0), skin)
        part("Left Leg", Vector3.new(0.8, 2, 0.8), CFrame.new(-0.5, -1.6, 0), cloth)
        part("Right Leg", Vector3.new(0.8, 2, 0.8), CFrame.new(0.5, -1.6, 0), cloth)
        return model
    end

    local function setupPreview()
        if not benchAlive or not ui.cosPreview then
            return
        end
        local world = ensurePreviewWorld()
        if not world then
            return
        end
        world:ClearAllChildren()
        previewModels = {}
        previewAngles = {}
        previewChar = nil
        previewRing = nil
        buildPlatform(world)

        local char = LocalPlayer.Character
        local model = nil
        if char and char:FindFirstChild("Head") then
            local ok, clone = pcall(function()
                return char:Clone()
            end)
            if ok and clone then
                model = clone
                local remove = {}
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("Script")
                        or d:IsA("LocalScript")
                        or d:IsA("Humanoid")
                        or d:IsA("Accessory")
                        or d:IsA("Hat")
                        or d:IsA("Tool") then
                        remove[#remove + 1] = d
                    end
                end
                for _, d in ipairs(remove) do
                    d:Destroy()
                end
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = true
                        d.CanCollide = false
                        d.CanQuery = false
                        d.CanTouch = false
                        d.CastShadow = false
                    end
                end
                model.Parent = world
                pcall(function()
                    model:PivotTo(CFrame.new(0, 0, 0))
                end)
            end
        end
        if not model then
            model = buildDummyPreview(world)
        end
        previewChar = model

        for _, key in ipairs(COS_KEYS) do
            previewModels[key] = builders[key](world, Config.cosmetic[key].color)
            previewAngles[key] = 0
        end
        cosmeticRefresh()
    end

    local function updatePreviewImpl(dt, t)
        if not previewWorld or not previewChar then
            return
        end
        local head = previewChar:FindFirstChild("Head")
        local torso = previewChar:FindFirstChild("UpperTorso")
            or previewChar:FindFirstChild("Torso")

        for i, key in ipairs(COS_KEYS) do
            local cm = previewModels[key]
            local cfg = Config.cosmetic[key]
            if cm then
                local base
                if key == "wings" or key == "dragonwings" then
                    if torso then
                        base = torso.CFrame
                            * CFrame.new(0, 0.35, torso.Size.Z * 0.5 + 0.12)
                    end
                elseif key == "dragon" then
                    local root = torso or head
                    if root then
                        local a = t * 1.35
                        local pos = Vector3.new(
                            math.cos(a) * 2.35,
                            0.85 + math.sin(t * 2.3) * 0.32,
                            math.sin(a) * 2.35
                        )
                        local vel = Vector3.new(-math.sin(a), 0, math.cos(a))
                        base = root.CFrame
                            * CFrame.lookAt(pos, pos + vel)
                    end
                elseif WEAPON_KEYS[key] then
                    local hand = findRightHand(previewChar)
                    if hand then
                        base = hand.CFrame * CFrame.new(0.08, -0.28, 0)
                    end
                elseif head then
                    base = head.CFrame
                        * CFrame.new(0, head.Size.Y * 0.5 + 0.05, 0)
                end

                local ghost = not cfg.enabled
                local visible = cfg.enabled or (Config.cosmetic.selected == i)
                if base and visible then
                    if key ~= "wings" and key ~= "dragonwings"
                        and key ~= "dragon" then
                        previewAngles[key] =
                            (previewAngles[key] or 0) + dt * math.rad(cfg.spin or 0)
                    end
                    updateModel(
                        cm,
                        base,
                        cfg,
                        t,
                        previewAngles[key] or 0,
                        true,
                        ghost
                    )
                else
                    setModelVisible(cm, false, false)
                end
            end
        end

        if ui.cosPreviewCam then
            previewSpin = previewSpin + dt * 0.55
            local radius = 7.4
            ui.cosPreviewCam.CFrame = CFrame.lookAt(
                Vector3.new(
                    math.cos(previewSpin) * radius,
                    1.7,
                    math.sin(previewSpin) * radius
                ),
                Vector3.new(0, -0.25, 0)
            )
        end
    end

    local function updateCosmeticsImpl(dt)
        if not benchAlive then
            return
        end
        dt = dt or 0.016
        local t = tick()
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        local torso = char
            and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))

        for _, key in ipairs(COS_KEYS) do
            local cm = worldModels[key]
            local cfg = Config.cosmetic[key]
            if cm then
                local base
                if key == "wings" or key == "dragonwings" then
                    if torso then
                        base = torso.CFrame
                            * CFrame.new(0, 0.35, torso.Size.Z * 0.5 + 0.12)
                    end
                elseif key == "dragon" then
                    local root = torso or head
                    if root then
                        local a = t * 1.35
                        local pos = Vector3.new(
                            math.cos(a) * 2.55,
                            0.85 + math.sin(t * 2.3) * 0.35,
                            math.sin(a) * 2.55
                        )
                        local vel = Vector3.new(-math.sin(a), 0, math.cos(a))
                        base = root.CFrame
                            * CFrame.lookAt(pos, pos + vel)
                    end
                elseif WEAPON_KEYS[key] then
                    local hand = findRightHand(char)
                    if hand then
                        -- vi tri tay de cam
                        base = hand.CFrame * CFrame.new(0.08, -0.28, 0)
                    end
                elseif head then
                    base = head.CFrame
                        * CFrame.new(0, head.Size.Y * 0.5 + 0.05, 0)
                end

                if base and cfg.enabled then
                    if key ~= "wings" and key ~= "dragonwings"
                        and key ~= "dragon" then
                        cm.angle = (cm.angle or 0) + dt * math.rad(cfg.spin or 0)
                    end
                    updateModel(cm, base, cfg, t, cm.angle or 0, true, false)
                else
                    setModelVisible(cm, false, false)
                end
            end
        end

        updatePreviewImpl(dt, t)

        saveAcc = saveAcc + dt
        if saveAcc >= 5 then
            saveAcc = 0
            saveSettings()
        end
    end
    updateCosmetics = updateCosmeticsImpl

    setupPreview()
    track(LocalPlayer.CharacterAdded:Connect(function()
        task.delay(0.8, setupPreview)
    end))

    cosmeticRefresh()

    hubSound = new("Sound", {
        Name = "BenchMusicSound",
        Volume = math.clamp(Config.yt.volume / 100, 0, 1),
        Looped = false,
    }, SoundService)
    track(hubSound.Ended:Connect(function()
        if benchAlive and ui.ytNext then
            task.defer(ui.ytNext)
        end
    end))
    local firstSong = Config.yt.tracks[Config.yt.index]
    if firstSong and ui.trackAsset then
        local id = ui.trackAsset(firstSong)
        if id ~= "" then
            hubSound.SoundId = id
        end
    end
    ytUpdateHub()
end
