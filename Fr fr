local function thumbBounds(card, cm)
    local minV = Vector3.new(math.huge, math.huge, math.huge)
    local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, item in ipairs(cm.parts) do
        local pos = item.offset.Position
        local h = item.size * 0.5
        minV = Vector3.new(
            math.min(minV.X, pos.X - h.X),
            math.min(minV.Y, pos.Y - h.Y),
            math.min(minV.Z, pos.Z - h.Z)
        )
        maxV = Vector3.new(
            math.max(maxV.X, pos.X + h.X),
            math.max(maxV.Y, pos.Y + h.Y),
            math.max(maxV.Z, pos.Z + h.Z)
        )
    end
    if minV.X > maxV.X then
        return
    end
    local ext = maxV - minV
    local maxDim = math.max(ext.X, ext.Y, ext.Z)
    card.thumbCenter = (minV + maxV) * 0.5
    card.thumbRadius = math.max(maxDim * 1.25 + 0.5, 2.2)
end

refreshCosThumbs = function(force)
    for i, def in ipairs(COSMETIC_DEFS) do
        local card = cosCards[i]
        if card then
            local visible = def.cat == cosCat
            if card.thumbModel and (force or not visible) then
                card.thumbWorld:ClearAllChildren()
                card.thumbModel = nil
            end
            if visible and not card.thumbModel and ui.thumbBuilder then
                local ok, cm = pcall(ui.thumbBuilder, def.key, card.thumbWorld)
                if ok and cm then
                    card.thumbModel = cm
                    local drop = {}
                    for _, d in ipairs(card.thumbWorld:GetDescendants()) do
                        if d:IsA("ParticleEmitter")
                            or d:IsA("Sparkles")
                            or d:IsA("Highlight")
                            or d:IsA("Trail")
                            or d:IsA("Beam")
                            or d:IsA("PointLight") then
                            drop[#drop + 1] = d
                        end
                    end
                    for _, d in ipairs(drop) do
                        d:Destroy()
                    end
                    thumbBounds(card, cm)
                end
            end
        end
    end
end

