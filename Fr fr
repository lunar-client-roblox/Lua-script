    local function setupPreview()
        if not benchAlive or not ui.cosPreview then
            return
        end
        local world = ensurePreviewWorld()
        if not world then
            return
        end
        world:ClearAllChildren()
        previewModels = {}
        previewAngles = {}
        previewChar = nil
        previewRing = nil
        if previewHand then
            previewHand:Destroy()
        end
        previewHand = nil
        previewHandShown = false
        previewBodyParts = {}
        buildPlatform(world)

        local char = LocalPlayer.Character
        local model = nil
        if char and char:FindFirstChild("Head") then
            local ok, clone = pcall(function()
                return char:Clone()
            end)
            if ok and clone then
                model = clone
                local remove = {}
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("Script")
                        or d:IsA("LocalScript")
                        or d:IsA("Humanoid")
                        or d:IsA("Accessory")
                        or d:IsA("Hat")
                        or d:IsA("Tool") then
                        remove[#remove + 1] = d
                    end
                end
                for _, d in ipairs(remove) do
                    d:Destroy()
                end
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = true
                        d.CanCollide = false
                        d.CanQuery = false
                        d.CanTouch = false
                        d.CastShadow = false
                    end
                end
                model.Parent = world
                pcall(function()
                    model:PivotTo(CFrame.new(0, 0, 0))
                end)
            end
        end
        if not model then
            model = buildDummyPreview(world)
        end
        previewChar = model
        previewBodyParts = {}
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                previewBodyParts[#previewBodyParts + 1] = {
                    part = d,
                    trans = d.Transparency,
                }
            end
        end
        previewHand = buildPreviewHand(world)
        previewHand.PrimaryPart = previewHand:FindFirstChild("Palm")
        if previewHand.PrimaryPart then
            previewHand:PivotTo(CFrame.new(0, 0.45, 0))
        end
        previewHand.Parent = nil

        for _, key in ipairs(COS_KEYS) do
            previewModels[key] = builders[key](world, Config.cosmetic[key].color)
