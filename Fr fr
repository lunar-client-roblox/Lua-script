local function makeAurora()
    for _, entry in ipairs(auroraRays) do
        if entry.p0 then
            entry.p0:Destroy()
        end
        if entry.p1 then
            entry.p1:Destroy()
        end
    end
    auroraRays = {}

    local function addBeam(kind, index, width0, width1)
        local p0 = new("Part", {
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            Transparency = 1,
            Size = Vector3.new(1, 1, 1),
        }, fxFolder)
        local p1 = new("Part", {
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            Transparency = 1,
            Size = Vector3.new(1, 1, 1),
        }, fxFolder)
        local a0 = new("Attachment", {}, p0)
        local a1 = new("Attachment", {}, p1)
        local beam = new("Beam", {
            Attachment0 = a0,
            Attachment1 = a1,
            FaceCamera = true,
            Segments = 16,
            LightEmission = 1,
            LightInfluence = 0,
            Width0 = width0,
            Width1 = width1,
            Color = ColorSequence.new(Config.sky.colorA, Config.sky.colorB),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.2, 0.45),
                NumberSequenceKeypoint.new(0.75, 0.55),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }, p0)
        auroraRays[#auroraRays + 1] = {
            kind = kind,
            index = index,
            p0 = p0,
            p1 = p1,
            beam = beam,
            phase = math.random() * math.pi * 2,
        }
    end

    for i = 1, 3 do
        addBeam("ribbon", i, 320, 520)
    end
    for i = 1, 20 do
        addBeam("ray", i, 44, 92)
    end
end

local function enableSky()
    if skyState then
        return
    end
    local oldSky = Lighting:FindFirstChildOfClass("Sky")
    local oldAtmo = Lighting:FindFirstChildOfClass("Atmosphere")
    skyState = {
        sky = oldSky,
        atmo = oldAtmo,
        clock = Lighting.ClockTime,
        ambient = Lighting.Ambient,
        outdoor = Lighting.OutdoorAmbient,
        brightness = Lighting.Brightness,
        fogEnd = Lighting.FogEnd,
    }
    if oldSky then
        oldSky.Parent = nil
    end
    if oldAtmo then
        oldAtmo.Parent = nil
    end
    skyState.newSky = new("Sky", {
        StarCount = 6000,
        CelestialBodiesShown = false,
    }, Lighting)
    skyState.newAtmo = new("Atmosphere", {
        Density = 0.28,
        Offset = 0.1,
        Glare = 0.2,
        Haze = 0.8,
        Color = Color3.fromRGB(34, 52, 110),
        Decay = Color3.fromRGB(22, 30, 66),
    }, Lighting)
    Lighting.ClockTime = 0
    Lighting.Ambient = Color3.fromRGB(12, 14, 34)
    Lighting.OutdoorAmbient = Color3.fromRGB(20, 24, 52)
    Lighting.Brightness = 1.2
    Lighting.FogEnd = 5000
    makeAurora()
end

local function disableSky()
    if not skyState then
        return
    end
    for _, entry in ipairs(auroraRays) do
        if entry.p0 then
            entry.p0:Destroy()
        end
        if entry.p1 then
            entry.p1:Destroy()
        end
    end
    auroraRays = {}
    if skyState.newSky then
        skyState.newSky:Destroy()
    end
    if skyState.newAtmo then
        skyState.newAtmo:Destroy()
    end
    if skyState.sky then
        skyState.sky.Parent = Lighting
    end
    if skyState.atmo then
        skyState.atmo.Parent = Lighting
    end
    Lighting.ClockTime = skyState.clock
    Lighting.Ambient = skyState.ambient
    Lighting.OutdoorAmbient = skyState.outdoor
    Lighting.Brightness = skyState.brightness
    Lighting.FogEnd = skyState.fogEnd
    skyState = nil
end

local function updateAurora()
    if not Config.sky.enabled then
        disableSky()
        return
    end
    enableSky()
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end

    local t = tick() * (Config.sky.speed / 100 + 0.05)
    local origin = cam.CFrame.Position
        + cam.CFrame.LookVector * 1400
        + Vector3.new(0, 700, 0)
    local right = cam.CFrame.RightVector

    local ca, cb = Config.sky.colorA, Config.sky.colorB
    if Config.sky.rainbow then
        ca = Color3.fromHSV((t * 0.08) % 1, 0.85, 1)
        cb = Color3.fromHSV((t * 0.08 + 0.35) % 1, 0.85, 1)
    end

    for _, entry in ipairs(auroraRays) do
        local i = entry.index
        local phase = entry.phase

        if entry.kind == "ribbon" then
            local u = (i - 2) / 2
            local sway = math.sin(t * 0.5 + phase) * 240
            entry.p0.Position = origin
                + right * (u * 1900 + sway)
                + Vector3.new(0, 120 + math.sin(t * 0.6 + phase) * 100, 0)
            entry.p1.Position = origin
                + right * (u * 1900 - sway * 0.6)
                + Vector3.new(0, -80 + math.cos(t * 0.5 + phase) * 80, 0)
        else
            local u = (i - 10.5) / 10
            local sway = math.sin(t * 0.7 + u * 5 + phase) * 180
            local height = 340 + math.sin(t * 0.9 + i) * 150
            entry.p0.Position = origin
                + right * (u * 2300 + sway)
                + Vector3.new(0, height, 0)
            entry.p1.Position = origin
                + right * (u * 2300 + sway * 0.55)
                + Vector3.new(0, -280 + math.cos(t * 0.8 + i) * 90, 0)
            entry.beam.Width0 = 40 + 44 * (0.5 + 0.5 * math.sin(t * 1.1 + i))
            entry.beam.Width1 = entry.beam.Width0 * 1.9
        end

        local fade = 0.42 + 0.22 * math.sin(t * 1.3 + phase)
        entry.beam.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.15, math.clamp(fade + 0.15, 0, 1)),
            NumberSequenceKeypoint.new(0.7, math.clamp(fade, 0, 1)),
            NumberSequenceKeypoint.new(1, 1),
        })

        local c0, c1 = ca, cb
        if entry.kind == "ray" then
            local k = (i - 1) / 20
            c0 = ca:Lerp(cb, k * 0.6)
            c1 = cb:Lerp(ca, 0.35)
        end
        entry.beam.Color = ColorSequence.new(c0, c1)
    end
end

--// jump fx
local humConn = nil

local function shockwave(pos, color, startRadius, endRadius, duration)
    local segments = 24
    local parts = {}
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        parts[i] = {
            angle = angle,
            part = new("Part", {
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                Material = Enum.Material.Neon,
                Color = color,
                Size = Vector3.new(0.35, 0.12, 1.4),
                CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
                    * CFrame.new(0, 0, startRadius),
                Transparency = 0.1,
            }, fxFolder),
        }
    end

    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not parts[1].part.Parent then
            conn:Disconnect()
            return
        end
        local a = math.clamp((tick() - start) / duration, 0, 1)
        local radius = startRadius + (endRadius - startRadius) * a
        local fade = 0.1 + 0.9 * a
        for _, entry in ipairs(parts) do
            entry.part.CFrame = CFrame.new(pos)
                * CFrame.Angles(0, entry.angle, 0)
                * CFrame.new(0, 0, radius)
            entry.part.Transparency = fade
            entry.part.Size = Vector3.new(
                0.35 * (1 - a),
                0.12,
                1.4 * (1 - a * 0.5)
            )
        end
        if a >= 1 then
            conn:Disconnect()
            for _, entry in ipairs(parts) do
                entry.part:Destroy()
            end
        end
    end)
end

local function jumpFx()
    if not Config.jump.enabled then
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local col = Config.jump.rainbow
        and Color3.fromHSV((tick() * 0.6) % 1, 0.85, 1)
        or Config.jump.color
    local pos = root.Position - Vector3.new(0, 2.7, 0)

    shockwave(pos, col, 1.4, 14, 0.55)
    task.delay(0.07, function()
        shockwave(pos, col:Lerp(Color3.new(1, 1, 1), 0.5), 0.8, 9, 0.45)
    end)

    local column = new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        Material = Enum.Material.Neon,
        Color = col,
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(8, 2.6, 2.6),
        CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
            * CFrame.Angles(0, 0, math.rad(90)),
        Transparency = 0.45,
    }, fxFolder)
    TweenService:Create(
        column,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(18, 0.4, 0.4), Transparency = 1 }
    ):Play()
    task.delay(0.5, function()
        column:Destroy()
    end)

    local burst = new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        Transparency = 1,
        Size = Vector3.new(1, 1, 1),
        CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)),
    }, fxFolder)
    local emitter = new("ParticleEmitter", {
        Color = ColorSequence.new(col),
        Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.9),
            NumberSequenceKeypoint.new(1, 0.1),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Lifetime = NumberRange.new(0.45, 0.8),
        Speed = NumberRange.new(14, 24),
        SpreadAngle = Vector2.new(180, 180),
        Rate = 0,
        LightEmission = 1,
        Texture = "rbxasset://textures/particles/sparkles_main.dds",
    }, burst)
    emitter:Emit(40)
    task.delay(1.1, function()
        burst:Destroy()
    end)
end

local function hookCharacter(char)
    if humConn then
        humConn:Disconnect()
        humConn = nil
    end
    local hum = char and char:WaitForChild("Humanoid", 5)
    if hum then
        humConn = hum.Jumping:Connect(jumpFx)
    end
end

hookCharacter(LocalPlayer.Character)
track(LocalPlayer.CharacterAdded:Connect(hookCharacter))

--// walk fx
local walkTrail = nil
local walkAttach0 = nil
local walkAttach1 = nil
local walkChar = nil

local function clearWalkTrail()
    if walkTrail then
        walkTrail:Destroy()
        walkTrail = nil
    end
    if walkAttach0 then
        walkAttach0:Destroy()
        walkAttach0 = nil
    end
    if walkAttach1 then
        walkAttach1:Destroy()
        walkAttach1 = nil
    end
    walkChar = nil
end

local function buildWalkTrail(char)
    clearWalkTrail()
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    walkChar = char
    walkAttach0 = new("Attachment", {
        Position = Vector3.new(0.8, -2.1, 0),
    }, root)
    walkAttach1 = new("Attachment", {
        Position = Vector3.new(-0.8, -2.1, 0),
    }, root)
    walkTrail = new("Trail", {
        Attachment0 = walkAttach0,
        Attachment1 = walkAttach1,
        Lifetime = 0.6,
        MinLength = 0.1,
        LightEmission = 1,
        LightInfluence = 0,
        FaceCamera = true,
        Texture = "rbxasset://textures/particles/fire_main.dds",
        TextureMode = Enum.TextureMode.Stretch,
        WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0.15),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(0.65, 0.55),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Color = ColorSequence.new(Config.walk.color),
        Enabled = false,
    }, root)
end

local function updateWalk()
    if not Config.walk.enabled then
        if walkTrail then
            walkTrail.Enabled = false
        end
        return
    end

    local char = LocalPlayer.Character
    if char ~= walkChar then
        buildWalkTrail(char)
    end
    if not walkTrail then
        return
    end

    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
    walkTrail.Enabled = moving
    if not moving then
        return
    end

    local t = tick()
    if Config.walk.rainbow or Config.walk.mode == 2 then
        local h = (t * 0.55) % 1
        walkTrail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0.9, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV((h + 0.25) % 1, 0.9, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV((h + 0.5) % 1, 0.9, 1)),
        })
        walkTrail.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        walkTrail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1.4),
            NumberSequenceKeypoint.new(1, 0.2),
        })
    else
        walkTrail.Color = ColorSequence.new(Config.walk.color)
        walkTrail.Texture = "rbxasset://textures/particles/fire_main.dds"
        walkTrail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0.15),
        })
    end
end

--// orbit fx
local orbitParts = {}
local orbitAcc = 0

local function clearOrbit()
    for _, part in ipairs(orbitParts) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    orbitParts = {}
end

local function spawnOrbitFx()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local kind = Config.orbit.kind
    local radius = Config.orbit.radius
    local angle = math.random() * math.pi * 2
    local dist = radius * (0.5 + math.random() * 0.7)
    local base = root.Position + Vector3.new(
        math.cos(angle) * dist,
        -1 + math.random() * 3,
        math.sin(angle) * dist
    )
    local col = Config.orbit.rainbow
        and Color3.fromHSV((tick() * 0.35 + math.random()) % 1, 0.85, 1)
        or Config.orbit.color

    local size, life, drift, transparency
    if kind == 1 then
        size = Vector3.new(0.22, 0.22, 0.22)
        life = 1.3
        drift = 2.2
        transparency = 0.15
    elseif kind == 2 then
        size = Vector3.new(0.6, 0.9, 0.6)
        life = 2.4
        drift = 3
        transparency = 0.05
    else
        size = Vector3.new(0.16, 0.16, 0.16)
        life = 1.8
        drift = 1.4
        transparency = 0.2
    end

    local part = new("Part", {
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        Material = Enum.Material.Neon,
        Shape = Enum.PartType.Ball,
        Size = size,
        Color = col,
        CFrame = CFrame.new(base),
        Transparency = transparency,
    }, fxFolder)
    orbitParts[#orbitParts + 1] = part

    if kind == 2 then
        new("PointLight", {
            Brightness = 2.2,
            Range = 9,
            Color = col,
        }, part)
    end

    if kind == 1 then
        local emitter = new("ParticleEmitter", {
            Color = ColorSequence.new(col),
            Size = NumberSequence.new(0.35),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.3),
                NumberSequenceKeypoint.new(1, 1),
            }),
            Lifetime = NumberRange.new(0.35, 0.7),
            Speed = NumberRange.new(1, 3),
            SpreadAngle = Vector2.new(180, 180),
            Rate = 0,
            LightEmission = 1,
            Texture = "rbxasset://textures/particles/sparkles_main.dds",
        }, part)
        emitter:Emit(8)
    end

    TweenService:Create(
        part,
        TweenInfo.new(life, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {
            CFrame = CFrame.new(base + Vector3.new(0, drift, 0)),
            Transparency = 1,
            Size = size * 0.35,
        }
    ):Play()

    task.delay(life + 0.2, function()
        part:Destroy()
    end)
end

local function updateOrbit(dt)
    if not Config.orbit.enabled then
        for i = #orbitParts, 1, -1 do
            if not orbitParts[i].Parent then
                table.remove(orbitParts, i)
            end
        end
        return
    end
    orbitAcc = orbitAcc + dt
    local interval = 0.9 / math.max(Config.orbit.count, 1)
    if orbitAcc < interval then
        return
    end
    orbitAcc = 0
    spawnOrbitFx()
end

