            local roll = rolls and rolls[mode] or 0
            if roll ~= 0 then
                cf = cf * CFrame.Angles(0, math.rad(roll), 0)
            end
            return cf
        end
        local center = modelBounds(cm)
        return CFrame.new(Vector3.new(0, 1.0, 0) - center)
