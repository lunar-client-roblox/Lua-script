    local function modelBounds(cm)
        local minV = Vector3.new(math.huge, math.huge, math.huge)
        local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
        if not cm then
            return Vector3.new(0, 0, 0), 2
        end
        for _, item in ipairs(cm.parts) do
            local pos = item.offset.Position
            local h = item.size * 0.5
            minV = Vector3.new(
                math.min(minV.X, pos.X - h.X),
                math.min(minV.Y, pos.Y - h.Y),
                math.min(minV.Z, pos.Z - h.Z)
            )
            maxV = Vector3.new(
                math.max(maxV.X, pos.X + h.X),
                math.max(maxV.Y, pos.Y + h.Y),
                math.max(maxV.Z, pos.Z + h.Z)
            )
        end
        if minV.X > maxV.X then
            return Vector3.new(0, 0, 0), 2
        end
        local ext = maxV - minV
        local maxDim = math.max(ext.X, ext.Y, ext.Z)
        return (minV + maxV) * 0.5, math.max(maxDim, 0.8)
    end

    local function itemBase(key, def, cm)
