local function enableSky()
    if skyState then
        return
    end
    local style = skyStyle()
    local oldSky = Lighting:FindFirstChildOfClass("Sky")
    local oldAtmo = Lighting:FindFirstChildOfClass("Atmosphere")
    local oldCC = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    skyState = {
        style = Config.sky.type,
        sky = oldSky,
        atmo = oldAtmo,
        cc = oldCC,
        clock = Lighting.ClockTime,
        ambient = Lighting.Ambient,
        outdoor = Lighting.OutdoorAmbient,
        brightness = Lighting.Brightness,
        fogEnd = Lighting.FogEnd,
    }
    if oldSky then
        oldSky.Parent = nil
    end
    if oldAtmo then
        oldAtmo.Parent = nil
    end
    if oldCC then
        oldCC.Parent = nil
    end

    skyState.newSky = new("Sky", {
        StarCount = math.clamp(style.stars or 0, 0, 3000),
        CelestialBodiesShown = style.bodies or false,
    }, Lighting)
    skyState.newAtmo = new("Atmosphere", {
        Density = style.density,
        Offset = 0.1,
        Glare = 0.2,
        Haze = style.haze or 0.9,
        Color = style.atmo,
        Decay = style.decay,
    }, Lighting)
    skyState.newCC = new("ColorCorrectionEffect", {
        TintColor = style.tint,
        Saturation = style.saturation,
        Contrast = style.contrast,
    }, Lighting)

    local light = Config.sky.light or 1
    local function scaled(c)
        return Color3.new(
            math.clamp(c.R * light, 0, 1),
            math.clamp(c.G * light, 0, 1),
            math.clamp(c.B * light, 0, 1)
        )
    end
    skyState.light = light
    Lighting.ClockTime = style.clock
    Lighting.Ambient = scaled(style.ambient)
    Lighting.OutdoorAmbient = scaled(style.outdoor)
    Lighting.Brightness = style.brightness * light
    local mistMult = Config.mist.enabled and Config.mist.density or 0
    Lighting.FogEnd = style.fog * (1 + mistMult * 0.5)

    makeAurora(style)
    if style.name == "Galaxy" then
        SKY_STYLES.galaxy(style)
    elseif style.name == "Void" then
        SKY_STYLES.void(style)
    end
end

local function disableSky()
    if not skyState then
        return
    end
    for _, entry in ipairs(auroraRays) do
        if entry.p0 then
            entry.p0:Destroy()
        end
        if entry.p1 then
            entry.p1:Destroy()
        end
    end
    auroraRays = {}
    if skyState.deep then
        if skyState.deep.galaxies then
            for _, g in ipairs(skyState.deep.galaxies) do
                if g.model then
                    g.model:Destroy()
                end
            end
        end
        if skyState.deep.void and skyState.deep.void.model then
            skyState.deep.void.model:Destroy()
        end
        skyState.deep = nil
    end
    if skyState.newSky then
        skyState.newSky:Destroy()
    end
    if skyState.newAtmo then
        skyState.newAtmo:Destroy()
    end
    if skyState.newCC then
        skyState.newCC:Destroy()
    end
    if skyState.sky then
        skyState.sky.Parent = Lighting
    end
    if skyState.atmo then
        skyState.atmo.Parent = Lighting
    end
    if skyState.cc then
        skyState.cc.Parent = Lighting
    end
    Lighting.ClockTime = skyState.clock
    Lighting.Ambient = skyState.ambient
    Lighting.OutdoorAmbient = skyState.outdoor
    Lighting.Brightness = skyState.brightness
    Lighting.FogEnd = skyState.fogEnd
    skyState = nil
end

