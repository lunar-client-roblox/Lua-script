local function registerOrbit(model, base, life, kind, extra)
    local parts = {}
    local lights = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            parts[#parts + 1] = { part = d, base = d.Transparency }
        elseif d:IsA("PointLight") then
            lights[#lights + 1] = { light = d, base = d.Brightness }
        end
    end
    orbitEntities[#orbitEntities + 1] = {
        model = model,
        base = base,
        t0 = tick(),
        life = life,
        kind = kind,
        parts = parts,
        lights = lights,
        phase = math.random() * math.pi * 2,
        scale = extra and extra.scale or 1,
        trail = extra and extra.trail or nil,
        emitter = extra and extra.emitter or nil,
        wingL = extra and extra.wingL or nil,
        wingR = extra and extra.wingR or nil,
        wingLOffset = extra and extra.wingLOffset or nil,
        wingROffset = extra and extra.wingROffset or nil,
    }
end

