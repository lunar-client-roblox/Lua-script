                    Size = Vector3.new(0.14, 0.14, len),
                    CFrame = CFrame.lookAt(mid, p1),
                    Transparency = 0.05,
                }, model)
            end
        end
        local lightPart = new("Part", {
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            CastShadow = false,
            Transparency = 1,
            Size = Vector3.new(0.2, 0.2, 0.2),
            CFrame = CFrame.new(a),
        }, model)
        local light = new("PointLight", {
            Brightness = 5,
            Range = 12,
            Color = ca,
        }, lightPart)
        local start = tick()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not model.Parent then
                conn:Disconnect()
                return
            end
            local age = tick() - start
            local fade = math.clamp(age / 0.22, 0, 1)
            for _, part in ipairs(parts) do
                part.Transparency = 0.05 + fade * 0.95
                part.Size = Vector3.new(
                    0.14 * (1 - fade * 0.7),
                    0.14 * (1 - fade * 0.7),
                    part.Size.Z
                )
            end
            light.Brightness = 5 * (1 - fade)
            if fade >= 1 then
                conn:Disconnect()
                model:Destroy()
            end
        end)
    end
end

local function updateWalk(dt)
    local style = walkStyle()

    if not Config.walk.enabled then
        if walkTrail and walkTrail.Parent then
            walkTrail.Enabled = false
        end
        if walkGlow and walkGlow.Parent then
            walkGlow.Enabled = false
        end
        for _, emitter in ipairs(walkEmitters) do
            if emitter and emitter.Parent then
                emitter.Rate = 0
                emitter.Enabled = false
            end
        end
        if walkAura and walkAura.Parent then
            walkAura.Rate = 0
            walkAura.Enabled = false
        end
        if walkLight and walkLight.Parent then
            walkLight.Brightness = 0
        end
        if walkExtra.rearFlame then
            walkExtra.rearFlame.Rate = 0
            walkExtra.rearFlame.Enabled = false
        end
        if walkExtra.rearSparks then
            walkExtra.rearSparks.Rate = 0
            walkExtra.rearSparks.Enabled = false
        end
        if walkExtra.rearLight then
            walkExtra.rearLight.Brightness = 0
        end
        return
    end

    local char = LocalPlayer.Character
    if char ~= walkChar or not walkTrail or not walkTrail.Parent then
        buildWalkTrail(char)
    end
    if not walkTrail or not walkTrail.Parent then
        return
    end

    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude
    local moving = hum.MoveDirection.Magnitude > 0.1 or speed > 2
    local boost = math.clamp(speed / 22, 0, 1)
    local power = 0.6 + (Config.walk.power or 1) * 0.4
    local width = style.width * power * (Config.walk.width or 1) * (1 + boost * 0.9)

    walkTrail.Enabled = moving
    walkGlow.Enabled = moving
    walkTrail.Lifetime = style.lifetime * (Config.walk.length or 1) * (1 + boost * 0.5)
    walkGlow.Lifetime = walkTrail.Lifetime * 1.6
    walkTrail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width),
        NumberSequenceKeypoint.new(1, 0.12),
    })
    walkGlow.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, width * 2.2),
        NumberSequenceKeypoint.new(1, 0.3),
    })

    local ca, cb = style.colorA, style.colorB
    if style.custom then
        ca = Config.walk.color
        cb = Config.walk.color:Lerp(Color3.new(1, 1, 1), 0.3)
    end
    if Config.walk.rainbow or style.name == "Rainbow" then
        local h = (tick() * 0.55) % 1
        ca = Color3.fromHSV(h, 0.9, 1)
        cb = Color3.fromHSV((h + 0.33) % 1, 0.9, 1)
    end
    local seq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ca),
        ColorSequenceKeypoint.new(0.5, cb),
        ColorSequenceKeypoint.new(1, ca:Lerp(Color3.new(1, 1, 1), 0.35)),
    })
    walkTrail.Color = seq
    walkGlow.Color = ColorSequence.new(
        ca:Lerp(Color3.new(1, 1, 1), 0.25),
        cb:Lerp(Color3.new(1, 1, 1), 0.15)
    )
    walkTrail.Texture = style.trailTexture
    walkGlow.Texture = style.glowTexture

    local rate = math.min(style.rate * power * (Config.walk.rate or 1) * (1 + boost), 240)
    for _, emitter in ipairs(walkEmitters) do
        if emitter and emitter.Parent then
            emitter.Color = seq
            emitter.Texture = style.particleTexture
            emitter.Speed = NumberRange.new(
                style.speedMin * (1 + boost * 0.6),
                style.speedMax * (1 + boost * 0.6)
            )
            emitter.Acceleration = Vector3.new(0, style.accelY or 8, 0)
            emitter.Rate = moving and rate or 0
            emitter.Enabled = moving
        end
    end

    if walkAura and walkAura.Parent then
        walkAura.Color = seq
        walkAura.Rate = moving and math.min(12 * power * (1 + boost), 40) or 0
        walkAura.Enabled = moving
    end

    if walkLight and walkLight.Parent then
        walkLight.Color = ca
        walkLight.Brightness = moving
            and (1.2 + boost * 2.2) * (Config.walk.brightness or 1.5)
            or 0
        walkLight.Range = 8 + boost * 4
    end

    local isFire = style.name == "Fire"
    local isLightning = style.name == "Lightning"
    local brightness = Config.walk.brightness or 1.5
    local rearFlame = walkExtra.rearFlame
    if rearFlame and rearFlame.Parent then
        rearFlame.Texture = isFire
            and "rbxasset://textures/particles/fire_main.dds"
            or style.particleTexture
        rearFlame.Color = seq
        rearFlame.Rate = moving
            and math.min(style.rate * power * (Config.walk.rate or 1) * 0.8, 200)
            or 0
        rearFlame.Enabled = moving
        rearFlame.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(
                0,
                (isFire and 1.7 or 1.0) * brightness * 0.75
            ),
            NumberSequenceKeypoint.new(1, 0.08),
        })
        rearFlame.Speed = NumberRange.new(
            (isFire and 1.8 or 4) * (1 + boost * 0.5),
            (isFire and 4.5 or 9) * (1 + boost * 0.5)
        )
        rearFlame.Acceleration = Vector3.new(
            0,
            isFire and 8 or (style.accelY or 3),
            0
        )
    end
    local rearSparks = walkExtra.rearSparks
    if rearSparks and rearSparks.Parent then
        rearSparks.Color = seq
        rearSparks.Rate = moving
            and math.min(style.rate * power * (Config.walk.rate or 1) * 0.5, 100)
            or 0
        rearSparks.Enabled = moving
        rearSparks.Speed = NumberRange.new(
            3 * (1 + boost * 0.6),
            (isLightning and 14 or 8) * (1 + boost * 0.6)
        )
        rearSparks.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(
                0,
                (isLightning and 0.5 or 0.3) * brightness
            ),
            NumberSequenceKeypoint.new(1, 0),
        })
    end
    local rearLight = walkExtra.rearLight
    if rearLight and rearLight.Parent then
        rearLight.Color = ca
        rearLight.Brightness = moving
            and (isFire and 3.2 or 1.6) * brightness
            or 0
        rearLight.Range = 10 + boost * 4
    end
    if isLightning and moving then
        walkExtra.boltAcc = (walkExtra.boltAcc or 0) + (dt or 0.016)
        if walkExtra.boltAcc >= 0.26 + math.random() * 0.34 then
            walkExtra.boltAcc = 0
            if walkExtra.spawnBolt then
                walkExtra.spawnBolt(root, ca, cb)
            end
        end
    else
        walkExtra.boltAcc = 0
    end
end

