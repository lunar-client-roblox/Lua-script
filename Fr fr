local function fmtTime(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function normalizeAudioId(raw)
    local text = tostring(raw or "")
    text = text:gsub("%s", "")
    if text == "" then
        return ""
    end
    text = text:gsub("rbxassetid://", "")
    text = text:gsub("rbxassetid:", "")
    local digits = text:match("(%d+)")
    if digits then
        return "rbxassetid://" .. digits
    end
    return ""
end

local function currentSong()
    return Config.yt.tracks[Config.yt.index]
end

local lyricCache = { index = -1, text = "", lines = {} }

local function parseLyrics(text)
    local lines = {}
    for raw in tostring(text or ""):gmatch("[^\r\n]+") do
        local mm, ss, frac, body = raw:match("^%s*%[(%d+):(%d+)%.?(%d*)%]%s*(.*)$")
        if mm then
            local t = tonumber(mm) * 60 + tonumber(ss)
            if frac and frac ~= "" then
                t = t + (tonumber("0." .. frac) or 0)
            end
            lines[#lines + 1] = { t = t, text = body }
        else
            local clean = raw:gsub("^%s+", ""):gsub("%s+$", "")
            if clean ~= "" then
                lines[#lines + 1] = { t = nil, text = clean }
            end
        end
    end
    local last = 0
    for _, line in ipairs(lines) do
        if line.t then
            last = line.t
        else
            line.t = last + 6
            last = line.t
        end
    end
    table.sort(lines, function(a, b)
        return a.t < b.t
    end)
    return lines
end

ytUpdateHub = function()
    if not benchAlive then
        return
    end
    local song = currentSong()
    hubTitle.Text = (song and song.title ~= "" and song.title) or "Chưa có nhạc"
    hubArtist.Text = (song and song.artist ~= "" and song.artist) or "Thêm file MP3 ở tab MUSIC"

    local length = 0
    local pos = 0
    if hubSound then
        length = hubSound.TimeLength or 0
        pos = hubSound.TimePosition or 0
    end
    hubTime.Text = fmtTime(pos)
    hubTotal.Text = fmtTime(length)
    local alpha = 0
    if length > 0 then
        alpha = math.clamp(pos / length, 0, 1)
    end
    hubFill.Size = UDim2.new(alpha, 0, 1, 0)
    hubPlay.Text = (hubSound and hubSound.IsPlaying) and "II" or "▶"

    local lyrics = song and song.lyrics or ""
    if lyricCache.index ~= Config.yt.index or lyricCache.text ~= lyrics then
        lyricCache.index = Config.yt.index
        lyricCache.text = lyrics
        lyricCache.lines = parseLyrics(lyrics)
    end

    local cur, nxt
    for i, line in ipairs(lyricCache.lines) do
        if line.t <= pos + 0.05 then
            cur = line
            nxt = lyricCache.lines[i + 1]
        else
            break
        end
    end
    if not cur then
        cur = lyricCache.lines[1]
        nxt = lyricCache.lines[2]
    end
    if cur then
        hubLyric1.Text = cur.text
        hubLyric2.Text = nxt and nxt.text or ""
    elseif song then
        if (song.path or "") ~= "" then
            hubLyric1.Text = "Local MP3 • " .. tostring(song.title or "")
            hubLyric2.Text = "Không cần mạng"
        else
            hubLyric1.Text = "Chưa có lyric — dán LRC ở tab MUSIC."
            hubLyric2.Text = ""
        end
    else
        hubLyric1.Text = ""
        hubLyric2.Text = ""
    end
end

ytPlay = function(i)
    if not benchAlive then
        return
    end
    local n = #Config.yt.tracks
    if n == 0 then
        toast("Playlist trống — thêm track trước.")
        return
    end
    i = math.clamp(tonumber(i) or 1, 1, n)
    Config.yt.index = i
    local song = Config.yt.tracks[i]
    local id = trackAsset and trackAsset(song) or normalizeAudioId(song.id)
    if hubSound then
        pcall(function()
            hubSound:Stop()
        end)
        if id ~= "" then
            hubSound.SoundId = id
            hubSound.Volume = Config.yt.volume / 100
            pcall(function()
                hubSound:Play()
            end)
        else
            hubSound.SoundId = ""
        end
    end
    task.spawn(function()
        ytRefreshPlaylist()
    end)
    ytUpdateHub()
    if id == "" then
        if (song.path or "") ~= "" then
            toast("Không đọc được file MP3 — executor thiếu getcustomasset.")
        else
            toast("Track chưa có audio ID — HUB chỉ hiện lyric.")
        end
    end
    saveSettings()
end

ytTogglePlay = function()
    if not benchAlive then
        return
    end
    local song = currentSong()
    if not song then
        toast("Playlist trống — thêm file hoặc audio ID trước.")
        return
    end
    local id = trackAsset and trackAsset(song) or normalizeAudioId(song.id)
    if id == "" then
        if (song.path or "") ~= "" then
            toast("Không đọc được file MP3 — executor thiếu getcustomasset.")
        else
            toast("Chưa có audio ID Roblox cho track này.")
        end
        return
    end
    if not hubSound then
        return
    end
    if hubSound.SoundId ~= id then
        hubSound.SoundId = id
        hubSound.TimePosition = 0
    end
    if hubSound.IsPlaying then
        hubSound:Pause()
    else
        if hubSound.TimeLength > 0 and hubSound.TimePosition >= hubSound.TimeLength - 0.05 then
            hubSound.TimePosition = 0
        end
        pcall(function()
            hubSound:Play()
        end)
    end
    ytUpdateHub()
end

