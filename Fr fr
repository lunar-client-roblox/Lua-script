end

local function saveSettings()
    local ok, encoded = pcall(function()
        local data = toData(Config)
        data.savedAt = os.time()
        return HttpService:JSONEncode(data)
    end)
    if not ok then
        return nil
    end
    if getgenv then
        pcall(function()
            getgenv().BenchUISettings = encoded
        end)
    end
    local wf = execEnv.writefile
    if type(wf) ~= "function" and type(writefile) == "function" then
        wf = writefile
    end
    if type(wf) == "function" then
        pcall(wf, SETTINGS_PATH, encoded)
    end
    return encoded
end

local function applySettingsData(data)
    if type(data) ~= "table" then
        return false
    end
    local decoded = fromData(data)
    for _, key in ipairs({
        "gui", "aim", "esp", "sky", "jump", "walk", "orbit", "cosmetic", "yt",
    }) do
        if decoded[key] ~= nil and type(decoded[key]) ~= "table" then
            return false
        end
    end
    if decoded.yt and decoded.yt.tracks ~= nil
        and type(decoded.yt.tracks) ~= "table" then
        return false
    end
    if decoded.cosmetic then
        for _, key in ipairs({
            "hat", "halo", "wizard", "wings", "dragonwings", "crown", "dragon",
            "trident", "thorhammer", "scythe",
        }) do
            if decoded.cosmetic[key] ~= nil
                and type(decoded.cosmetic[key]) ~= "table" then
                return false
            end
        end
    end
    mergeSettings(Config, decoded)
    if type(decoded.yt) == "table" and type(decoded.yt.tracks) == "table" then
        local arr = {}
        for _, item in ipairs(decoded.yt.tracks) do
            if type(item) == "table" then
                arr[#arr + 1] = item
            end
        end
        Config.yt.tracks = arr
    end

    Config.gui.font = math.clamp(tonumber(Config.gui.font) or 1, 1, #FONTS)
    Config.gui.borderWidth = math.clamp(tonumber(Config.gui.borderWidth) or 1, 0, 6)
    Config.gui.corner = math.clamp(tonumber(Config.gui.corner) or 16, 0, 30)
    Config.gui.transparency = math.clamp(tonumber(Config.gui.transparency) or 0, 0, 1)
    Config.gui.imageTransparency = math.clamp(
        tonumber(Config.gui.imageTransparency) or 0.85,
        0,
        1
    )
    Config.gui.imageId = tostring(Config.gui.imageId or "")

    local function keepColor(value, fallback)
        if typeof(value) == "Color3" then
            return value
        end
        return fallback
    end
    Config.gui.accent = keepColor(Config.gui.accent, Color3.fromRGB(0, 170, 255))
    Config.gui.bg = keepColor(Config.gui.bg, Color3.fromRGB(18, 19, 23))
    Config.gui.border = keepColor(Config.gui.border, Color3.fromRGB(44, 47, 55))
    Config.esp.color = keepColor(Config.esp.color, Color3.fromRGB(0, 170, 255))
    Config.esp.targetColor = keepColor(Config.esp.targetColor, Color3.fromRGB(255, 64, 64))
    Config.sky.colorA = keepColor(Config.sky.colorA, Color3.fromRGB(80, 255, 190))
    Config.sky.colorB = keepColor(Config.sky.colorB, Color3.fromRGB(130, 90, 255))
    Config.jump.color = keepColor(Config.jump.color, Color3.fromRGB(255, 220, 80))
    Config.walk.color = keepColor(Config.walk.color, Color3.fromRGB(255, 120, 60))
    Config.orbit.color = keepColor(Config.orbit.color, Color3.fromRGB(255, 220, 80))

    Config.cosmetic.selected = math.clamp(tonumber(Config.cosmetic.selected) or 1, 1, 10)
    Config.aim.mode = math.clamp(tonumber(Config.aim.mode) or 1, 1, #AIM_MODES)
    Config.aim.part = math.clamp(tonumber(Config.aim.part) or 1, 1, #AIM_PARTS)
    Config.aim.fov = math.clamp(tonumber(Config.aim.fov) or 220, 80, 600)
    Config.aim.smooth = math.clamp(tonumber(Config.aim.smooth) or 6, 1, 20)
    Config.aim.predict = math.clamp(tonumber(Config.aim.predict) or 0, 0, 30)
    Config.esp.style = math.clamp(tonumber(Config.esp.style) or 1, 1, #ESP_STYLES)
    Config.esp.targetSpin = math.clamp(tonumber(Config.esp.targetSpin) or 90, 0, 720)
    Config.sky.type = math.clamp(tonumber(Config.sky.type) or 1, 1, #SKY_NAMES)
    Config.sky.speed = math.clamp(tonumber(Config.sky.speed) or 40, 0, 100)
    Config.walk.mode = math.clamp(tonumber(Config.walk.mode) or 1, 1, #WALK_MODES)
    Config.walk.power = math.clamp(tonumber(Config.walk.power) or 1, 1, 3)
    Config.orbit.kind = math.clamp(tonumber(Config.orbit.kind) or 1, 1, #ORBIT_KINDS)
    Config.orbit.count = math.clamp(tonumber(Config.orbit.count) or 8, 1, 10)
    Config.orbit.radius = math.clamp(tonumber(Config.orbit.radius) or 3.5, 2, 80)
    Config.orbit.size = math.clamp(tonumber(Config.orbit.size) or 1, 1, 3)
    Config.yt.volume = math.clamp(tonumber(Config.yt.volume) or 60, 0, 100)
    Config.yt.hubX = math.clamp(tonumber(Config.yt.hubX) or 0.62, 0, 1)
    Config.yt.hubY = math.clamp(tonumber(Config.yt.hubY) or 0.68, 0, 1)
    if #Config.yt.tracks == 0 then
        Config.yt.index = 1
    else
        Config.yt.index = math.clamp(tonumber(Config.yt.index) or 1, 1, #Config.yt.tracks)
    end

    for _, key in ipairs({
        "hat", "halo", "wizard", "wings", "dragonwings", "crown", "dragon",
        "trident", "thorhammer", "scythe",
    }) do
        local c = Config.cosmetic[key]
        if type(c) == "table" then
            c.x = tonumber(c.x) or 0
            c.y = tonumber(c.y) or 0
            c.z = tonumber(c.z) or 0
            c.scale = math.clamp(tonumber(c.scale) or 1, 0.5, 8)
            c.spin = math.clamp(tonumber(c.spin) or 0, 0, 360)
            c.enabled = c.enabled == true
            if typeof(c.color) ~= "Color3" then
                c.color = Color3.fromRGB(120, 180, 255)
            end
        end
    end

    if type(Config.yt.tracks) ~= "table" then
        Config.yt.tracks = {}
    end
    Config.yt.hub = Config.yt.hub == true
    local cleanTracks = {}
    for _, item in ipairs(Config.yt.tracks) do
        if type(item) == "table" then
            cleanTracks[#cleanTracks + 1] = {
                id = tostring(item.id or ""),
                path = tostring(item.path or ""),
                kind = tostring(item.kind or ""),
                title = tostring(item.title or "Untitled"),
                artist = tostring(item.artist or ""),
                lyrics = tostring(item.lyrics or ""),
            }
        end
    end
    Config.yt.tracks = cleanTracks
    if #Config.yt.tracks == 0 then
        Config.yt.index = 1
    else
        Config.yt.index = math.clamp(Config.yt.index, 1, #Config.yt.tracks)
    end

    if applyTheme then
        pcall(applyTheme)
    end
    if cosmeticRefresh then
        pcall(cosmeticRefresh)
    end
    if ui.renderCosControls then
        pcall(ui.renderCosControls)
    end
    if ytRefreshPlaylist then
        pcall(ytRefreshPlaylist)
    end
    if musicHub then
        musicHub.Visible = Config.yt.hub
        if Config.yt.hub and applyHubPos then
            pcall(applyHubPos)
        end
    end
    if hubSound then
        hubSound.Volume = Config.yt.volume / 100
        local song = Config.yt.tracks[Config.yt.index]
        local id = ""
        if song then
            if ui.trackAsset then
                id = ui.trackAsset(song)
            elseif ui.audioId then
                id = ui.audioId(song.id)
            end
        end
        if hubSound.SoundId ~= id then
            pcall(function()
                hubSound:Stop()
            end)
            hubSound.SoundId = id
            hubSound.TimePosition = 0
        end
    end
    if ytUpdateHub then
        pcall(ytUpdateHub)
    end
    saveSettings()
    return true
end

local function loadSettings()
    local rawList = {}
    local rf = execEnv.readfile
    if type(rf) ~= "function" and type(readfile) == "function" then
        rf = readfile
    end
    local isf = execEnv.isfile
    if type(isf) ~= "function" and type(isfile) == "function" then
        isf = isfile
    end
    if type(rf) == "function" then
        local exists = true
        if type(isf) == "function" then
            local ok, res = pcall(isf, SETTINGS_PATH)
            exists = ok and res
        end
        if exists then
            local ok, raw = pcall(rf, SETTINGS_PATH)
            if ok and type(raw) == "string" then
                rawList[#rawList + 1] = raw
            end
        end
    end
    if getgenv then
        local ok, raw = pcall(function()
            return getgenv().BenchUISettings
        end)
        if ok and type(raw) == "string" then
            rawList[#rawList + 1] = raw
        end
    end

    local best, bestTime = nil, -1
    for _, raw in ipairs(rawList) do
        local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(data) == "table" then
            local stamp = tonumber(data.savedAt) or 0
            if stamp >= bestTime then
                best, bestTime = data, stamp
            end
        end
    end
    if best then
        pcall(applySettingsData, best)
    end
end

