local visualRatioGroup = collapsible(pages.render, "visual ratio", true)
toggleRow(visualRatioGroup, "4:3 aspect", false, function(v)
    if v then
        if not _G.BenchAspectBars then
            _G.BenchAspectBars = true
            local barL = new("Frame", {
                Size = UDim2.new(0.5, 0, 1, 0),
                Position = UDim2.fromScale(0, 0),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 100,
            }, espGui)
            local barR = new("Frame", {
                Size = UDim2.new(0.5, 0, 1, 0),
                Position = UDim2.fromScale(0.5, 0),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 100,
            }, espGui)
            local function applyBars()
                if not _G.BenchAspectBars then
                    return
                end
                local vp = viewport()
                local targetAspect = 4 / 3
                local currentAspect = vp.X / math.max(vp.Y, 1)
                if currentAspect > targetAspect then
                    local barWidth = (vp.X - vp.Y * targetAspect) / 2
                    barL.Size = UDim2.fromOffset(barWidth, vp.Y)
                    barL.Position = UDim2.fromOffset(0, 0)
                    barR.Size = UDim2.fromOffset(barWidth, vp.Y)
                    barR.Position = UDim2.fromOffset(vp.X - barWidth, 0)
                elseif currentAspect < targetAspect then
                    local barHeight = (vp.Y - vp.X / targetAspect) / 2
                    barL.Size = UDim2.fromOffset(vp.X, barHeight)
                    barL.Position = UDim2.fromOffset(0, 0)
                    barR.Size = UDim2.fromOffset(vp.X, barHeight)
                    barR.Position = UDim2.fromOffset(0, vp.Y - barHeight)
                else
                    barL.Size = UDim2.fromOffset(0, 0)
                    barR.Size = UDim2.fromOffset(0, 0)
                end
            end
            applyBars()
            _G.BenchAspectL = barL
            _G.BenchAspectR = barR
            local cam = workspace.CurrentCamera
            if cam then
                if _G.BenchAspectConn then
                    _G.BenchAspectConn:Disconnect()
                end
                _G.BenchAspectConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyBars)
                track(_G.BenchAspectConn)
            end
        end
    else
        if _G.BenchAspectL then
            _G.BenchAspectL:Destroy()
            _G.BenchAspectL = nil
        end
        if _G.BenchAspectR then
            _G.BenchAspectR:Destroy()
            _G.BenchAspectR = nil
        end
        if _G.BenchAspectConn then
            _G.BenchAspectConn:Disconnect()
            _G.BenchAspectConn = nil
        end
        _G.BenchAspectBars = false
    end
end)
