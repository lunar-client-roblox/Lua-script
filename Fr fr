        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = label,
    }, row)

    local trackBtn = new("TextButton", {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -40, 0.5, -11),
        BackgroundColor3 = Theme.bg2,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
    }, row)
    corner(trackBtn, 11)
    tint(trackBtn, "BackgroundColor3", "bg2")

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(160, 166, 178),
        BorderSizePixel = 0,
    }, trackBtn)
    corner(knob, 8)

    local state = default

    local function render(animate)
        local goal = state
            and UDim2.new(1, -19, 0.5, -8)
            or UDim2.new(0, 3, 0.5, -8)
        trackBtn.BackgroundColor3 = state and Theme.accent or Theme.bg2
        knob.BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(160, 166, 178)
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.12), { Position = goal }):Play()
        else
            knob.Position = goal
        end
    end
    render(false)

    track(trackBtn.Activated:Connect(function()
        state = not state
        render(true)
        if onChange then
            onChange(state)
        end
    end))

    return addOrder(parent, row)
end

local function sliderRow(parent, label, min, max, default, suffix, onChange)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)

    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = label,
    }, row)

    local valueLabel = new("TextLabel", {
        Position = UDim2.new(1, -70, 0, 0),
        Size = UDim2.new(0, 70, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Theme.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    tint(valueLabel, "TextColor3", "accent")

    local bar = new("Frame", {
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = Theme.bg2,
        BorderSizePixel = 0,
    }, row)
    corner(bar, 5)
    tint(bar, "BackgroundColor3", "bg2")

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 5)
    tint(fill, "BackgroundColor3", "accent")

    local hit = new("TextButton", {
        Position = UDim2.new(0, 0, 0, 16),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        BorderSizePixel = 0,
    }, row)

    local value = default

    local function render()
        local a = (value - min) / math.max(max - min, 0.0001)
        fill.Size = UDim2.new(math.clamp(a, 0, 1), 0, 1, 0)
        valueLabel.Text = string.format("%d%s", math.floor(value + 0.5), suffix or "")
    end

    local dragging = false
    local function apply(input)
        local ax = bar.AbsolutePosition.X
        local aw = math.max(bar.AbsoluteSize.X, 1)
        local a = math.clamp((input.Position.X - ax) / aw, 0, 1)
        value = math.floor(min + (max - min) * a + 0.5)
        render()
        if onChange then
            onChange(value)
        end
    end

    track(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            apply(input)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            apply(input)
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    render()
    return addOrder(parent, row)
end

