local function updateAurora(dt)
    if not Config.sky.enabled then
        disableSky()
        return
    end
    if skyState and skyState.style ~= Config.sky.type then
        disableSky()
    end
    enableSky()

    local style = skyStyle()
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end

    local t = tick() * (Config.sky.speed / 100 + 0.05)
    local origin = cam.CFrame.Position
        + cam.CFrame.LookVector * 1400
        + Vector3.new(0, 700, 0)
    local right = cam.CFrame.RightVector
    local look = cam.CFrame.LookVector

    local ca, cb
    if style.colorA and style.colorB then
        ca, cb = style.colorA, style.colorB
    else
        ca, cb = Config.sky.colorA, Config.sky.colorB
    end
    if Config.sky.rainbow then
        ca = Color3.fromHSV((t * 0.08) % 1, 0.85, 1)
        cb = Color3.fromHSV((t * 0.08 + 0.35) % 1, 0.85, 1)
    end

    for _, entry in ipairs(auroraRays) do
        local phase = entry.phase
        local beam = entry.beam

        if entry.kind == "ray" then
            local half = math.max(style.rays.count / 2, 1)
            local u = (entry.index - (style.rays.count + 1) / 2) / half
            local sway = math.sin(t * style.rays.speed + u * 5 + phase) * 180
            local height = style.rays.top + math.sin(t * 0.9 + entry.index) * 150
            entry.p0.Position = origin
                + right * (u * style.rays.spread + sway)
                + look * entry.depth
                + Vector3.new(0, height, 0)
            entry.p1.Position = origin
                + right * (u * style.rays.spread + sway * 0.55)
                + look * (entry.depth * 0.8)
                + Vector3.new(0, style.rays.bottom + math.cos(t * 0.8 + entry.index) * 90, 0)
            beam.Width0 = style.rays.width * (0.7 + 0.5 * math.sin(t * 1.1 + entry.index))
            beam.Width1 = beam.Width0 * 1.9
        else
            local half = math.max(style.bands.count / 2, 1)
            local u = (entry.index - (style.bands.count + 1) / 2) / half
            local sway = math.sin(t * style.bands.speed + u * 4 + phase) * 260
            entry.p0.Position = origin
                + right * (u * style.bands.spread + sway)
                + look * entry.depth
                + Vector3.new(0, style.bands.top + math.sin(t * 0.6 + phase) * 90, 0)
            entry.p1.Position = origin
                + right * (u * style.bands.spread + sway * 0.7 + 340)
                + look * (entry.depth * 0.6)
                + Vector3.new(0, style.bands.bottom + math.cos(t * 0.5 + phase) * 70, 0)
            beam.Width0 = style.bands.width * (0.8 + 0.3 * math.sin(t * 0.8 + entry.index))
            beam.Width1 = beam.Width0 * 1.45
        end

        local fade = 0.42 + 0.22 * math.sin(t * 1.3 + phase)
        beam.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.15, math.clamp(fade + 0.15, 0, 1)),
            NumberSequenceKeypoint.new(0.7, math.clamp(fade, 0, 1)),
            NumberSequenceKeypoint.new(1, 1),
        })

        local c0, c1 = ca, cb
        if entry.kind == "ray" then
            local k = entry.index / math.max(style.rays.count, 1)
            c0 = ca:Lerp(cb, k * 0.6)
            c1 = cb:Lerp(ca, 0.35)
        end
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c0:Lerp(Color3.new(1, 1, 1), 0.35)),
            ColorSequenceKeypoint.new(0.45, c0),
            ColorSequenceKeypoint.new(1, c1),
        })
    end

    if style.lightning then
        stormTimer = stormTimer - (dt or 0.016)
        if stormTimer <= 0 then
            stormTimer = 2.5 + math.random() * 4.5
            stormFlash()
        end
    end
end

