local function sliderRow(parent, label, min, max, default, suffix, onChange)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)

    new("TextLabel", {
        Size = UDim2.new(1, -70, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = label,
    }, row)

    local valueLabel = new("TextLabel", {
        Position = UDim2.new(1, -70, 0, 0),
        Size = UDim2.new(0, 70, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Theme.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    tint(valueLabel, "TextColor3", "accent")

    local bar = new("Frame", {
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = Theme.bg2,
        BorderSizePixel = 0,
    }, row)
    corner(bar, 5)
    tint(bar, "BackgroundColor3", "bg2")

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 5)
    tint(fill, "BackgroundColor3", "accent")

    local hit = new("TextButton", {
        Position = UDim2.new(0, 0, 0, 16),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = "",
        BorderSizePixel = 0,
    }, row)

    local value = default

    local function render()
        local a = (value - min) / math.max(max - min, 0.0001)
        fill.Size = UDim2.new(math.clamp(a, 0, 1), 0, 1, 0)
        valueLabel.Text = string.format("%d%s", math.floor(value + 0.5), suffix or "")
    end

    local dragging = false
    local function apply(input)
        local ax = bar.AbsolutePosition.X
        local aw = math.max(bar.AbsoluteSize.X, 1)
        local a = math.clamp((input.Position.X - ax) / aw, 0, 1)
        value = math.floor(min + (max - min) * a + 0.5)
        render()
        if onChange then
            onChange(value)
        end
    end

    track(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            apply(input)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            apply(input)
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    render()
    return addOrder(parent, row)
end

