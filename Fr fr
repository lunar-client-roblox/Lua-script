--// teardown
unload = function()
    benchAlive = false
    pcall(saveSettings)

    if hubSound then
        pcall(function()
            hubSound:Stop()
            hubSound:Destroy()
        end)
        hubSound = nil
    end
    if musicGui then
        pcall(function()
            musicGui:Destroy()
        end)
        musicGui = nil
        musicHub = nil
    end

    for _, conn in ipairs(connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    connections = {}

    if humConn then
        pcall(function()
            humConn:Disconnect()
        end)
        humConn = nil
    end

    silentTarget = nil
    if silentReady and silentOld and restorefunction then
        pcall(function()
            restorefunction(silentOld)
        end)
        silentReady = false
    end

    pcall(disableSky)
    pcall(clearOrbit)
    pcall(clearWalkTrail)
    pcall(function()
        if fxFolder then
            fxFolder:Destroy()
        end
    end)
    pcall(function()
        gui:Destroy()
    end)
    pcall(function()
        espGui:Destroy()
    end)
    pcall(function()
        targetHighlight:Destroy()
    end)

    if getgenv then
        getgenv().BenchUnload = nil
    end
end

if getgenv then
    getgenv().BenchUnload = unload
end



