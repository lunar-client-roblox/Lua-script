        local model = new("Model", { Name = "BenchWalkBolt" }, fxFolder)
        local origin = root.CFrame * CFrame.new(
            (math.random() - 0.5) * 2.4,
            1.1 + math.random() * 1.2,
            1.0 + math.random() * 1.4
        )
