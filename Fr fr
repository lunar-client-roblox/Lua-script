local function updateOrbit(dt)
    dt = dt or 0.016
    local now = tick()
    for i = #orbitEntities, 1, -1 do
        local entity = orbitEntities[i]
        local age = now - entity.t0
        local a = age / entity.life
        if not entity.model or not entity.model.Parent or a >= 1 then
            if entity.model then
                entity.model:Destroy()
            end
            table.remove(orbitEntities, i)
        else
            local fade = math.clamp(a * a, 0, 1)

            if entity.kind == 2 then
                local pos = entity.base + Vector3.new(
                    math.sin(age * 0.6 + entity.phase) * 0.35,
                    age * 1.1 + math.sin(age * 1.8 + entity.phase) * 0.25,
                    math.cos(age * 0.5 + entity.phase) * 0.35
                )
                entity.model:PivotTo(
                    CFrame.new(pos)
                        * CFrame.Angles(
                            0,
                            age * 0.7 + entity.phase,
                            math.sin(age * 1.3 + entity.phase) * 0.08
                        )
                )
            elseif entity.kind == 3 then
                local pos = entity.base + Vector3.new(
                    math.sin(age * 1.7 + entity.phase) * 1.3,
                    math.sin(age * 2.3 + entity.phase * 1.7) * 0.55 + age * 0.35,
                    math.cos(age * 1.3 + entity.phase) * 1.3
                )
                local nextPos = entity.base + Vector3.new(
                    math.sin((age + 0.08) * 1.7 + entity.phase) * 1.3,
                    math.sin((age + 0.08) * 2.3 + entity.phase * 1.7) * 0.55
                        + (age + 0.08) * 0.35,
                    math.cos((age + 0.08) * 1.3 + entity.phase) * 1.3
                )
                local dir = nextPos - pos
                if dir.Magnitude < 0.001 then
                    dir = Vector3.new(0, 0, 1)
                end
                local cf = CFrame.lookAt(pos, pos + dir.Unit)
                entity.model:PivotTo(cf)
                if entity.wingL then
                    local flap = math.sin(age * 34 + entity.phase) * 0.55
                    entity.wingL.CFrame = cf * entity.wingLOffset
                        * CFrame.Angles(0, 0, flap)
                    entity.wingR.CFrame = cf * entity.wingROffset
                        * CFrame.Angles(0, 0, -flap)
                end
            else
                local pos = entity.base + Vector3.new(
                    math.sin(age * 0.9 + entity.phase) * 0.4,
                    age * 1.6,
                    math.cos(age * 0.8 + entity.phase) * 0.4
                )
                entity.model:PivotTo(
                    CFrame.new(pos)
                        * CFrame.Angles(age * 2.2, age * 3.1, age * 1.7)
                )
            end

            for _, entry in ipairs(entity.parts) do
                entry.part.Transparency = math.clamp(
                    entry.base + (1 - entry.base) * fade,
                    0,
                    1
                )
            end
            for _, entry in ipairs(entity.lights) do
                entry.light.Brightness = entry.base * (1 - fade)
            end
            if entity.trail and a > 0.6 then
                entity.trail.Enabled = false
            end
            if entity.emitter and a > 0.65 then
                entity.emitter.Enabled = false
            end
        end
    end

    if not Config.orbit.enabled then
        return
    end

    local kind = Config.orbit.kind
    local cap = (kind == 2) and 12 or ((kind == 3) and 16 or 20)
    if #orbitEntities >= cap then
        return
    end

    orbitAcc = orbitAcc + dt
    local baseInterval = (kind == 2) and 2.4 or ((kind == 3) and 1.5 or 1)
    local interval = baseInterval / math.max(Config.orbit.count, 1)
    if orbitAcc < interval then
        return
    end
    orbitAcc = 0

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local radius = Config.orbit.radius
    local scale = 0.7 + (Config.orbit.size or 1) * 0.3
    local angle = math.random() * math.pi * 2
    local dist = radius * (0.45 + math.random() * 0.75)
    local base
    if kind == 2 then
        base = root.Position + Vector3.new(
            math.cos(angle) * dist,
            -2.4 + math.random() * 0.8,
            math.sin(angle) * dist
        )
    elseif kind == 3 then
        base = root.Position + Vector3.new(
            math.cos(angle) * dist,
            -0.5 + math.random() * 2.5,
            math.sin(angle) * dist
        )
    else
        base = root.Position + Vector3.new(
            math.cos(angle) * dist,
            -1 + math.random() * 3,
            math.sin(angle) * dist
        )
    end

    local col = orbitColor()
    if kind == 2 then
        spawnLantern(base, col, scale)
    elseif kind == 3 then
        spawnFirefly(base, col, scale)
    else
        spawnSparkle(base, col, scale)
    end
end


