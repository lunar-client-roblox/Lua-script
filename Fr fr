track(RunService.RenderStepped:Connect(function(dt)
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end

    currentTarget = findTarget()
    local mode = Config.aim.mode
    if Config.aim.enabled and currentTarget then
        if mode == 2 or mode == 3 or mode == 4 then
            installSilent()
            silentTarget = currentTarget
        else
            silentTarget = nil
        end
        if mode == 1 or mode == 3 then
            applyAim(currentTarget, mode == 3 and 0.45 or 1)
        elseif mode == 2 and not silentReady then
            applyAim(currentTarget, 1)
        elseif mode == 4 then
            applyAim(currentTarget, 0.35)
        end
    else
        silentTarget = nil
    end

    updateEsp()
    updateTargetFx()
    updateAurora(dt)
    updateWalk(dt)
    updateOrbit(dt)
    updateCosmetics(dt)
    if ytUpdateHub then
        ytUpdateHub()
    end

    fovCircle.Visible = Config.aim.enabled
    if Config.aim.enabled then
        fovCircle.Size = UDim2.fromOffset(Config.aim.fov, Config.aim.fov)
        fovStroke.Color = Theme.accent
    end

    local swipeOn = Config.aim.enabled and Config.aim.mode == 4
    ui.swipeDot.Visible = swipeOn
    if swipeOn then
        ui.swipeDot.Position = UDim2.fromOffset(
            cam.ViewportSize.X * 0.5 + aimSwipeOffset.X,
            cam.ViewportSize.Y * 0.5 + aimSwipeOffset.Y
        )
        ui.swipeStroke.Color = Theme.accent
        ui.swipeCore.BackgroundColor3 = Theme.accent
    end
end))

