    local function findRightHand(char)
        if not char then
            return nil
        end
        return char:FindFirstChild("RightHand")
            or char:FindFirstChild("Right Arm")
            or char:FindFirstChild("RightLeg")
            or char:FindFirstChild("Right Leg")
    end

    local function updateModel(cm, base, cfg, t, angle, visible, ghost)
        local scale = math.max(0.1, cfg.scale or 1)
        local root = base
            * CFrame.new(cfg.x or 0, cfg.y or 0, cfg.z or 0)
            * CFrame.Angles(0, angle or 0, 0)

        for _, item in ipairs(cm.parts) do
            local part = item.part
            if part and part.Parent then
                local cf
                if item.kind == "rune" then
                    cf = root
                        * CFrame.Angles(0, t * 1.6 + item.angle, 0)
                        * CFrame.new(item.radius * scale, item.y * scale, 0)
                        * item.offset.Rotation
                elseif item.kind == "wing" then
                    local speed = math.max(0, cfg.spin or 0)
                    local flap = math.rad(
                        math.sin(t * speed * 0.12 + item.side * 0.7) * 9
                    )
                    cf = root
                        * CFrame.Angles(0, item.side * flap, 0)
                        * CFrame.new(item.offset.Position * scale)
                        * item.offset.Rotation
                else
                    cf = root
                        * CFrame.new(item.offset.Position * scale)
                        * item.offset.Rotation
                end
                part.CFrame = cf
                part.Size = item.size * scale
                if visible then
                    part.Transparency = ghost
                        and math.max(item.baseTrans, 0.62)
                        or item.baseTrans
                else
                    part.Transparency = 1
                end
            end
        end
    end

    local function recolorFx(part, col)
        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("PointLight") then
                child.Color = col
            elseif child:IsA("Sparkles") then
                child.Color = col
            elseif child:IsA("ParticleEmitter") then
                child.Color = ColorSequence.new(col, col)
            elseif child:IsA("Highlight") then
                child.FillColor = col
                child.OutlineColor = col:Lerp(Color3.new(1, 1, 1), 0.4)
            elseif child:IsA("Trail") then
                child.Color = ColorSequence.new(col, col)
            elseif child:IsA("Beam") then
                child.Color = ColorSequence.new(col, col)
            end
        end
    end

    cosmeticRefresh = function()
        for _, key in ipairs(COS_KEYS) do
            local cfg = Config.cosmetic[key]
            local cm = worldModels[key]
            if cm then
                for _, item in ipairs(cm.parts) do
                    local col = item.fixed or cfg.color
                    if not item.fixed and item.lerp > 0 then
                        col = col:Lerp(Color3.new(1, 1, 1), item.lerp)
                    end
                    item.part.Color = col
                    recolorFx(item.part, col)
                end
                if not cfg.enabled then
                    setModelVisible(cm, false, false)
                end
            end

            local pm = previewModels[key]
            if pm then
                for _, item in ipairs(pm.parts) do
                    local col = item.fixed or cfg.color
                    if not item.fixed and item.lerp > 0 then
                        col = col:Lerp(Color3.new(1, 1, 1), item.lerp)
                    end
                    item.part.Color = col
                    recolorFx(item.part, col)
                end
            end
        end
        if previewRing and previewRing.Parent then
            previewRing.Color = Theme.accent
        end
    end

