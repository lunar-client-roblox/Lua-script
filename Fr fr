    local function setModelVisible(cm, visible, ghost)
        if not cm then
            return
        end
        for _, item in ipairs(cm.parts) do
            local part = item.part
            if part and part.Parent then
                if visible then
                    part.Transparency = ghost
                        and math.max(item.baseTrans, 0.62)
                        or item.baseTrans
                else
                    part.Transparency = 1
                end
            end
        end
    end

