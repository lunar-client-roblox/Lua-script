local function openColorPicker(target, field, swatch, onChange)
    local h, s, v = Color3.toHSV(target[field])
    colorState.target = target
    colorState.field = field
    colorState.swatch = swatch
    colorState.onChange = onChange
    colorState.h, colorState.s, colorState.v = h, s, v
    refreshPicker()
    popup.Visible = true
end

local function colorPicker(parent, label, target, field, onChange)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)

    new("TextLabel", {
        Size = UDim2.new(1, -72, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = label,
    }, row)

    local swatch = new("TextButton", {
        Size = UDim2.new(0, 56, 0, 24),
        Position = UDim2.new(1, -56, 0.5, -12),
        BackgroundColor3 = target[field],
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
    }, row)
    corner(swatch, 7)
    stroke(swatch, Theme.stroke, 1)

    colorSwatches[#colorSwatches + 1] = {
        swatch = swatch,
        target = target,
        field = field,
    }

    track(swatch.Activated:Connect(function()
        openColorPicker(target, field, swatch, onChange)
    end))

    return addOrder(parent, row)
end

