    local function addCosPart(model, parts, size, offset, color, transparency, shape, extra)
        local class = (extra and extra.class) or "Part"
        local props = {
            Size = size,
            CFrame = offset,
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            CastShadow = false,
            Material = (extra and extra.material) or Enum.Material.Neon,
            Color = color,
            Transparency = transparency or 0,
        }
        if shape and class == "Part" then
            props.Shape = shape
        end
        local part = new(class, props, model)
        local item = {
            part = part,
            size = size,
            offset = offset,
            baseTrans = transparency or 0,
            kind = (extra and extra.kind) or "static",
            side = (extra and extra.side) or 1,
            radius = (extra and extra.radius) or 0,
            y = (extra and extra.y) or 0,
            angle = (extra and extra.angle) or 0,
            lerp = (extra and extra.lerp) or 0,
            fixed = extra and extra.fixed or nil,
        }
        parts[#parts + 1] = item
        return part
    end

    --// nang cap do hoa: hieu ung phat sang cho cosmetic
    local function addSpecialMesh(part, meshType, meshId, scale, offset)
        local mesh = new("SpecialMesh", {
            MeshType = meshType or Enum.MeshType.Brick,
            MeshId = meshId or "",
            Scale = scale or Vector3.new(1, 1, 1),
            Offset = offset or Vector3.zero,
        }, part)
        return mesh
    end

    local function addParticle(part, opts)
        local o = opts or {}
        local emitter = new("ParticleEmitter", {
            Name = o.name or "CosFx",
            Texture = o.texture or "rbxasset://textures/particles/sparkles_main.dds",
            Color = o.color or ColorSequence.new(part.Color, part.Color),
            Size = o.size or NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.35),
                NumberSequenceKeypoint.new(0.5, 0.15),
                NumberSequenceKeypoint.new(1, 0),
