local function rainbowColor(base, speed, offset)
    if not Config.esp.rainbow then
        return base
    end
    local h = (tick() * (speed or 0.15) + (offset or 0)) % 1
    return Color3.fromHSV(h, 0.85, 1)
end

local function setLine(line, a, b, thickness)
    local dx, dy = b.X - a.X, b.Y - a.Y
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 2 then
        line.Visible = false
        return
    end
    line.Visible = true
    line.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
    line.Size = UDim2.fromOffset(len, thickness or 2.0)
    line.Rotation = math.deg(math.atan2(dy, dx))
end

