applyTheme = function()
    syncTheme()

    for _, entry in ipairs(themed) do
        local inst = entry.inst
        if inst and inst.Parent then
            pcall(function()
                inst[entry.prop] = Theme[entry.key]
            end)
        end
    end

    panel.BackgroundColor3 = Theme.bg
    panel.BackgroundTransparency = Config.gui.transparency

    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox"))
            and not d:GetAttribute("noFontTheme") then
            pcall(function()
                d.Font = FONTS[Config.gui.font].font
            end)
        end
    end

    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("UICorner") and d:GetAttribute("themedCorner") then
            d.CornerRadius = UDim.new(0, Config.gui.corner)
        end
        if d:IsA("UIStroke") and d:GetAttribute("themedStroke") then
            d.Color = Theme.stroke
            d.Thickness = Config.gui.borderWidth
        end
