            (math.random() - 0.5) * 5.5,
            -2.8 + math.random() * 1.2,
            2.4 + math.random() * 3.2
        )
        local a = origin.Position
        local b = target.Position
        local points = { a }
        local segments = 6
        for i = 1, segments - 1 do
            local t = i / segments
            local base = a:Lerp(b, t)
            points[#points + 1] = base + Vector3.new(
                (math.random() - 0.5) * 1.4,
                (math.random() - 0.5) * 0.8,
                (math.random() - 0.5) * 1.0
            )
        end
        points[#points + 1] = b
        local parts = {}
        for i = 1, #points - 1 do
            local p0, p1 = points[i], points[i + 1]
            local mid = (p0 + p1) * 0.5
            local len = (p1 - p0).Magnitude
            if len > 0.05 then
                parts[#parts + 1] = new("Part", {
                    Anchored = true,
                    CanCollide = false,
                    CanQuery = false,
                    CanTouch = false,
                    CastShadow = false,
                    Material = Enum.Material.Neon,
