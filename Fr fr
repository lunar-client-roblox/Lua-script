ytDeleteTrack = function(i)
    if not benchAlive or not Config.yt.tracks[i] then
        return
    end
    local wasCurrent = Config.yt.index == i
    if i < Config.yt.index then
        Config.yt.index = Config.yt.index - 1
    end
    table.remove(Config.yt.tracks, i)
    if #Config.yt.tracks == 0 then
        Config.yt.index = 1
    elseif Config.yt.index > #Config.yt.tracks then
        Config.yt.index = #Config.yt.tracks
    end
    if wasCurrent and hubSound then
        pcall(function()
            hubSound:Stop()
        end)
        hubSound.SoundId = ""
    end
    ytRefreshPlaylist()
    ytUpdateHub()
    saveSettings()
end

local function ensureMusicFolder()
    local make = execEnv.makefolder or makefolder
    if type(make) == "function" then
        pcall(make, MUSIC_FOLDER)
    end
    local wf = execEnv.writefile or writefile
    if type(wf) == "function" then
        pcall(wf, MUSIC_FOLDER .. "/README.txt",
            "Thả file .mp3 / .ogg / .wav vào folder này.\n"
            .. "Mở tab MUSIC trong Bench UI và bấm REFRESH LOCAL FILES.\n")
    end
end

local function scanMusicFiles()
    local list = execEnv.listfiles or listfiles
    if type(list) ~= "function" then
        return nil
    end
    local ok, files = pcall(list, MUSIC_FOLDER)
    if not ok or type(files) ~= "table" then
        return {}
    end
    local out = {}
    for _, raw in ipairs(files) do
        local path = tostring(raw)
        local lower = string.lower(path)
        if lower:match("%.mp3$") or lower:match("%.ogg$") or lower:match("%.wav$") then
            local name = path:match("([^/\\]+)$") or path
            local title = name:gsub("%.[^%.]+$", "")
            out[#out + 1] = { path = path, title = title }
        end
    end
    table.sort(out, function(a, b)
        return string.lower(a.title) < string.lower(b.title)
    end)
    return out
end

local function fileAsset(path)
    local fn = execEnv.getcustomasset or execEnv.getsynasset
        or execEnv.get_custom_asset
    if type(fn) ~= "function" then
        fn = getcustomasset or getsynasset
    end
    if type(fn) == "function" then
        local ok, asset = pcall(fn, path)
        if ok and type(asset) == "string" and asset ~= "" then
            return asset
        end
    end
    return nil
end

trackAsset = function(song)
    if type(song) ~= "table" then
        return ""
    end
    if (song.path or "") ~= "" then
        return fileAsset(song.path) or ""
    end
    return normalizeAudioId(song.id)
end

refreshMusicLibrary = function(silent)
    ensureMusicFolder()
    local files = scanMusicFiles()
    if not files then
        if ytLibStatus then
            ytLibStatus.Text = "Executor không hỗ trợ listfiles — dùng audio ID bên dưới."
        end
        if not silent then
            toast("Executor không hỗ trợ listfiles.")
        end
        return
    end

    local oldSong = Config.yt.tracks[Config.yt.index]
    local oldPath = oldSong and (oldSong.path or "") or ""
    local oldId = oldSong and (oldSong.id or "") or ""
    local oldTitle = oldSong and (oldSong.title or "") or ""

    local manual = {}
    for _, t in ipairs(Config.yt.tracks) do
        if (t.path or "") == "" then
            manual[#manual + 1] = t
        end
    end

    local tracks = {}
    for _, f in ipairs(files) do
        tracks[#tracks + 1] = {
            id = "",
            path = f.path,
            kind = "file",
            title = f.title,
            artist = "local file",
            lyrics = "",
        }
    end
    for _, t in ipairs(manual) do
        tracks[#tracks + 1] = t
    end
    Config.yt.tracks = tracks

    local found = false
    for i, t in ipairs(tracks) do
        if oldPath ~= "" and t.path == oldPath then
            Config.yt.index = i
            found = true
            break
        elseif oldPath == "" and oldId ~= "" and t.id == oldId then
            Config.yt.index = i
            found = true
            break
        elseif oldPath == "" and oldId == "" and oldTitle ~= ""
            and t.title == oldTitle then
            Config.yt.index = i
            found = true
            break
        end
    end
    if not found then
        Config.yt.index = 1
        if hubSound then
            pcall(function()
                hubSound:Stop()
            end)
            hubSound.SoundId = ""
        end
    end

    ytRefreshPlaylist()
    ytUpdateHub()
    if ytLibStatus then
        ytLibStatus.Text = string.format(
            "%d file local · %d track tổng · %s",
            #files,
            #tracks,
            MUSIC_FOLDER
        )
    end
    if not silent then
        if #files == 0 then
            toast("Không thấy file .mp3/.ogg/.wav trong " .. MUSIC_FOLDER)
        else
            toast("Đã nạp " .. #files .. " file local.")
        end
    end
    saveSettings()
end

