local humConn = nil

local function shockwave(pos, color, startRadius, endRadius, duration)
    local segments = 24
    local parts = {}
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        parts[i] = {
            angle = angle,
            part = new("Part", {
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Material = Enum.Material.Neon,
                Color = color,
                Size = Vector3.new(0.35, 0.12, 1.4),
                CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
                    * CFrame.new(0, 0, startRadius),
                Transparency = 0.1,
            }, fxFolder),
        }
    end

    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not parts[1].part.Parent then
            conn:Disconnect()
            return
        end
        local a = math.clamp((tick() - start) / duration, 0, 1)
        local radius = startRadius + (endRadius - startRadius) * a
        local fade = 0.1 + 0.9 * a
        for _, entry in ipairs(parts) do
            entry.part.CFrame = CFrame.new(pos)
                * CFrame.Angles(0, entry.angle, 0)
                * CFrame.new(0, 0, radius)
            entry.part.Transparency = fade
            entry.part.Size = Vector3.new(
                0.35 * (1 - a),
                0.12,
                1.4 * (1 - a * 0.5)
            )
        end
